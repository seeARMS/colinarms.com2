{
  "name": "armstr.ng",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build",
    "preview": "npm run build && XDG_CONFIG_HOME=\"$HOME/.config/wrangler-personal\" wrangler dev",
    "deploy": "npm run build && XDG_CONFIG_HOME=\"$HOME/.config/wrangler-personal\" wrangler deploy",
    "lint": "eslint src",
    "test": "node --test redirect/",
    "deploy:www": "XDG_CONFIG_HOME=\"$HOME/.config/wrangler-personal\" wrangler deploy --config redirect/wrangler.jsonc",
    "cf": "XDG_CONFIG_HOME=\"$HOME/.config/wrangler-personal\" wrangler"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "exifr": "^7.1.3",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "shiki": "^4.4.3",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "vite": "$vite"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
