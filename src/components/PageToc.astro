---
// "On this page", from heade.rs: a rail of dots in the left margin, one per
// heading in the post. A ring sits on the part you're reading. Bring the
// pointer near and every title slides out beside its dot, rippling from the
// one you're closest to (dots near the pointer swell a little); move away and
// they ripple back. Click to glide there. It only appears for posts with at
// least three parts, and only on screens wide enough to keep it in the margin.
---

<nav class="toc" aria-label="On this page" data-toc hidden>
  <ol class="list" data-toc-list></ol>
  <span class="ring" aria-hidden="true"></span>
  <template data-toc-item>
    <li class="item">
      <a class="link" href="#">
        <span class="dot" aria-hidden="true"></span>
        <span class="label"></span>
      </a>
    </li>
  </template>
</nav>

<script is:inline>
  ;(() => {
    const nav = document.querySelector('[data-toc]')
    if (!nav) return
    const list = nav.querySelector('[data-toc-list]')
    const tpl = nav.querySelector('[data-toc-item]')
    const ring = nav.querySelector('.ring')
    const calm = matchMedia('(prefers-reduced-motion: reduce)')
    const entries = []
    let active
    let placed = false

    const clamp = (x) => Math.max(0, Math.min(1, x))
    const ease = (x) => x * x * (3 - 2 * x)
    const slug = (s) =>
      s
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')

    function add(key, title, target) {
      const li = tpl.content.firstElementChild.cloneNode(true)
      const a = li.querySelector('a')
      a.href = `#${key}`
      const label = li.querySelector('.label')
      label.textContent = title
      li.dataset.new = ''
      li.addEventListener('animationend', () => delete li.dataset.new, { once: true })
      const entry = { key, target, li, label, p: 0 }
      a.addEventListener('click', (e) => {
        e.preventDefault()
        go(entry, e.detail === 0)
      })
      list.append(li)
      entries.push(entry)
    }

    // The post's own headings, each given an id to link to.
    const head = document.querySelector('main .page-head')
    if (head) add('top', 'Top', head)
    for (const h of document.querySelectorAll('main .prose :is(h1, h2)')) {
      const title = h.textContent.trim()
      if (!title) continue
      if (!h.id) {
        let id = slug(title) || 'section'
        while (document.getElementById(id)) id += '-'
        h.id = id
      }
      add(h.id, title, h)
    }
    nav.hidden = entries.length < 4

    // The ring sits on the part you're reading.
    function spy() {
      if (!entries.length || nav.hidden) return
      const line = innerHeight * 0.35
      let current = entries[0]
      for (const e of entries) if (e.target.getBoundingClientRect().top <= line) current = e
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = entries[entries.length - 1]
      if (current !== active) {
        if (active) delete active.li.dataset.active
        active = current
        active.li.dataset.active = ''
      }
      const y = active.li.offsetTop + active.li.offsetHeight / 2
      ring.style.transition = placed ? '' : 'none'
      ring.style.transform = `translateY(${y}px)`
      ring.style.opacity = '1'
      placed = true
    }
    let spying = false
    addEventListener(
      'scroll',
      () => {
        if (spying) return
        spying = true
        requestAnimationFrame(() => {
          spying = false
          spy()
        })
      },
      { passive: true },
    )
    addEventListener('resize', spy, { passive: true })

    function go(entry, keyboard) {
      const el = entry.target
      const top = entry.key === 'top' ? 0 : el.getBoundingClientRect().top + scrollY - 84
      scrollTo({ top, behavior: calm.matches ? 'auto' : 'smooth' })
      history.replaceState(null, '', entry.key === 'top' ? location.pathname : `#${entry.key}`)
      // A soft flash on the heading once it's there, so the eye lands on it.
      const heading = entry.key === 'top' ? el.querySelector('h1') : el
      const arrive = () => {
        if (!heading) return
        heading.classList.remove('arrived')
        void heading.offsetWidth
        heading.classList.add('arrived')
        if (keyboard) {
          heading.setAttribute('tabindex', '-1')
          heading.focus({ preventScroll: true })
        }
      }
      if ('onscrollend' in window && !calm.matches && Math.abs(scrollY - top) > 2)
        addEventListener('scrollend', arrive, { once: true })
      else arrive()
    }

    // Near the rail: every title slides out, rippling from the dot the pointer
    // is closest to. The dots swell like a lens around the pointer meanwhile.
    let open = false
    function setOpen(value, from) {
      open = value
      entries.forEach((e, i) => e.li.style.setProperty('--d', `${Math.abs(i - from) * (value ? 22 : 12)}ms`))
      nav.toggleAttribute('data-open', value)
    }

    let px = -1e4
    let py = -1e4
    let raf = 0
    let last = 0
    const settled = () => !open && entries.every((e) => e.p === 0)
    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse' || nav.hidden) return
        px = e.clientX
        py = e.clientY
        // Far away and already at rest: nothing to do.
        if (px < list.getBoundingClientRect().right + 360 || !settled()) kick()
      },
      { passive: true },
    )
    document.documentElement.addEventListener('pointerleave', () => {
      px = py = -1e4
      kick()
    })
    function kick() {
      if (raf) return
      last = performance.now()
      raf = requestAnimationFrame(frame)
    }
    function frame(now) {
      const dt = Math.min(64, now - last)
      last = now
      const k = calm.matches ? 1 : 1 - Math.exp(-dt / 70)
      const box = list.getBoundingClientRect()
      const cx = box.left + 3

      // Distance from the pointer to the rail (and, while open, to its titles).
      let right = box.left + 16
      if (open) for (const e of entries) right = Math.max(right, e.label.getBoundingClientRect().right + 8)
      const gx = px < box.left - 16 ? box.left - 16 - px : px > right ? px - right : 0
      const gy = py < box.top - 12 ? box.top - 12 - py : py > box.bottom + 12 ? py - box.bottom - 12 : 0
      const gap = Math.hypot(gx, gy)
      let nearest = 0
      let best = Infinity
      entries.forEach((e, i) => {
        const r = e.li.getBoundingClientRect()
        const d = Math.abs(py - (r.top + r.height / 2))
        if (d < best) {
          best = d
          nearest = i
        }
      })
      // A little hysteresis, so the titles don't flicker at the edge.
      const shouldOpen = gap < (open ? 48 : 32)
      if (shouldOpen !== open) setOpen(shouldOpen, nearest)

      const near = ease(clamp(1 - (Math.max(0, px - cx) - 16) / 220))
      let moving = false
      for (const e of entries) {
        const r = e.li.getBoundingClientRect()
        const dy = Math.abs(py - (r.top + r.height / 2))
        const p = near * ease(clamp(1 - dy / 96))
        e.p += (p - e.p) * k
        if (Math.abs(p - e.p) < 0.002) e.p = p
        if (e.p !== p) moving = true
        e.li.style.setProperty('--p', e.p.toFixed(3))
      }
      raf = moving ? requestAnimationFrame(frame) : 0
    }

    spy()
  })()
</script>

<style>
  /* Centered in the left margin beside the post column. */
  .toc {
    position: fixed;
    top: calc(50vh - 96px);
    left: max(12px, calc((100vw - var(--post)) / 4 - 3px));
    z-index: 20;
  }

  .toc[hidden] {
    display: none;
  }

  @media (max-width: 1099px), (pointer: coarse), print {
    .toc {
      display: none;
    }
  }

  .list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    --p: 0;
    --d: 0ms;
    position: relative;
    height: 24px;
  }

  .item[data-new] {
    animation: arrive 0.45s var(--ease) both;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  /* The link is only as big as the dot (plus a comfortable hit area), so a
     hidden title never sits over the page and swallows clicks. */
  .link {
    position: absolute;
    top: 50%;
    left: -9px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: -12px;
    border-radius: 50%;
    color: inherit;
    outline: none;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
    opacity: calc(0.55 + var(--p) * 0.45);
    transform: scale(calc(1 + var(--p) * 0.6));
    transition: background-color 200ms;
  }

  .item[data-active] .dot {
    background: var(--ink);
    opacity: 1;
  }

  .label {
    position: absolute;
    top: 50%;
    left: 22px;
    max-width: min(34ch, calc((100vw - var(--post)) / 2 - 64px));
    padding: 3px 9px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow:
      0 0 0 1px var(--line),
      0 2px 8px rgb(0 0 0 / 0.05);
    /* The title nearest the pointer reads darkest. */
    color: color-mix(in srgb, var(--ink) calc(var(--p) * 100%), var(--ink-2));
    font-size: 12.5px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-6px, -50%);
    pointer-events: none;
    transition:
      opacity 0.18s ease var(--d),
      transform 0.28s var(--ease) var(--d);
  }

  /* Keyboard focus opens it too (not a mouse click, which also focuses the link). */
  .toc[data-open] .label,
  .toc:has(.link:focus-visible) .label {
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }

  .item[data-active] .label {
    color: var(--ink);
    font-weight: 500;
  }

  .link:hover .label {
    color: var(--ink);
  }

  .link:focus-visible .label {
    box-shadow:
      0 0 0 2px var(--blue),
      0 2px 8px rgb(0 0 0 / 0.05);
  }

  /* Centered on the active dot: 14px ring, dot center at x=3 and at each item's middle. */
  .ring {
    position: absolute;
    top: -7px;
    left: -4px;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--ink-2);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.5s var(--ease),
      opacity 0.3s;
  }

  @media (prefers-reduced-motion: reduce) {
    .item[data-new] {
      animation: none;
    }

    .ring {
      transition: opacity 0.3s;
    }

    .label {
      transform: translate(0, -50%);
      transition: opacity 0.12s;
    }
  }
</style>
