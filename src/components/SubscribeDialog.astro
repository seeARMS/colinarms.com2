---
import SubscribeForm from './SubscribeForm.astro'
---

<dialog class="dialog" aria-labelledby="subscribe-title" data-subscribe-dialog>
  <div class="top">
    <h2 id="subscribe-title">Subscribe</h2>
    <button class="btn square close" type="button" aria-label="Close" data-close>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <p class="note">Get new posts delivered to your inbox.</p>
  <SubscribeForm />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-subscribe-dialog]')

  if (dialog) {
    const close = () => {
      if (!dialog.open || dialog.dataset.closing !== undefined) return
      dialog.dataset.closing = ''
      const done = () => {
        delete dialog.dataset.closing
        dialog.close()
      }
      dialog.addEventListener('animationend', done, { once: true })
      setTimeout(done, 200)
    }

    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-subscribe]')) {
        dialog.showModal()
        dialog.querySelector('input')?.focus()
      }
    })
    dialog.querySelector('[data-close]')?.addEventListener('click', close)
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close()
    })
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault()
      close()
    })
  }

  // Every subscribe field on the page, including the one in the dialog.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-subscribe-form]')) {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-subscribe-status]')
    const input = form.elements.namedItem('email') as HTMLInputElement
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    const say = (text: string, tone: 'ok' | 'error') => {
      if (!status) return
      status.textContent = text
      status.dataset.tone = tone
    }
    const shake = () => {
      delete form.dataset.shake
      void form.offsetWidth
      form.dataset.shake = ''
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = input.value.trim()
      if (!input.checkValidity() || !email) {
        say('Enter an email address, like you@example.com.', 'error')
        shake()
        input.focus()
        return
      }

      if (button) button.disabled = true
      const website = (form.elements.namedItem('website') as HTMLInputElement | null)?.value ?? ''
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website }),
        })
        const data = await res.json().catch(() => ({}))
        if (res.ok) {
          say('Subscribed. New posts will arrive by email.', 'ok')
          form.reset()
        } else {
          say(data.error || "Couldn't subscribe right now. Try again in a moment.", 'error')
          shake()
        }
      } catch {
        say("Couldn't reach the server. Check your connection and try again.", 'error')
        shake()
      } finally {
        if (button) button.disabled = false
      }
    })
  }
</script>

<style>
  .dialog {
    width: min(420px, calc(100vw - 32px));
    margin: auto;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 16px 48px rgb(0 0 0 / 0.12);
  }

  .dialog[open] {
    animation: enter 0.26s var(--ease);
  }

  .dialog[data-closing] {
    animation: leave 0.14s ease-in forwards;
  }

  .dialog::backdrop {
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .dialog[open]::backdrop {
    animation: fade 0.26s ease-out;
  }

  .dialog[data-closing]::backdrop {
    animation: fade 0.14s ease-in reverse forwards;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }

  @keyframes leave {
    to {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  h2 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .close {
    border-color: transparent;
    background: none;
    color: var(--ink-2);
  }

  .note {
    margin: 4px 0 16px;
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .dialog[open],
    .dialog[open]::backdrop {
      animation: none;
    }
  }
</style>
