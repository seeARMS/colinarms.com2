---
// Where I've worked, as a table with a shared time axis: each role's bar sits
// where it happened, from the first year to today. The bars grow in the order
// the jobs came, and the one that's still going keeps a pulse at its end.
//
// Years are all the data has, so each end sits mid-year: 2017–2022 runs from
// mid-2017 to mid-2022, which is honest about how much is known.
import Mark from './Mark.astro'
import type { Role } from '@/data/profile'

interface Props {
  roles: Role[]
  /** 'link' rows go to the full entry; 'expand' rows open their details. */
  variant?: 'link' | 'expand'
}

const { roles, variant = 'link' } = Astro.props

const now = new Date()
const yearStart = Date.UTC(now.getUTCFullYear(), 0, 1)
const yearLength = Date.UTC(now.getUTCFullYear() + 1, 0, 1) - yearStart
const today = now.getUTCFullYear() + (now.getTime() - yearStart) / yearLength
const start = Math.min(...roles.map((r) => r.from))
const span = today - start
const at = (y: number) => Math.min(1, Math.max(0, (y - start) / span))

// Bars draw in the order the jobs started, so the story reads left to right.
const byStart = [...roles].sort((a, b) => a.from - b.from)

const rows = roles.map((role) => ({
  ...role,
  slug: role.company.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  current: role.to === undefined,
  a: at(role.from + 0.5),
  b: role.to === undefined ? 1 : at(role.to + 0.5),
  delay: byStart.indexOf(role) * 0.22,
  years: `${role.from}–${role.to ?? 'now'}`,
}))
---

<div class="card work" data-work style={`--span:${span.toFixed(3)}`}>
  <div class="line head-row" aria-hidden="true">
    <span>Company</span>
    <span>Role</span>
    <span class="axis"><span class="num">{start}</span><span>Now</span></span>
    <span>Years</span>
    <span></span>
  </div>
  <ol class="roles">
    {
      rows.map((role) => {
        const cells = (
          <>
            <span class="who">
              <Mark logo={role.logo} size={20} />
              <span class="co">{role.company}</span>
            </span>
            <span class="what">{role.summary}</span>
            <span class="track" role="img" aria-label={`${role.years.replace('–', ' to ')}`}>
              {/* Spans, not <i>: an italic element makes the browser fetch Geist Italic. */}
              <span class="bar" />
              {role.current && <span class="tip" />}
            </span>
            <span class="yrs mono num">{role.years}</span>
          </>
        )
        return (
          <li
            class="role"
            id={role.slug}
            style={`--a:${role.a.toFixed(4)};--b:${role.b.toFixed(4)};--delay:${role.delay}s`}
            data-current={role.current ? '' : undefined}
          >
            {variant === 'expand' ? (
              <>
                <button
                  class="line"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`${role.slug}-detail`}
                  data-role-toggle
                  data-vt-work={role.slug}
                >
                  {cells}
                  <svg class="caret" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="m6 3.5 4.5 4.5L6 12.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class="detail" id={`${role.slug}-detail`} data-open="false">
                  <div class="clip">
                    <div class="text">
                      {role.details.map((d) => (
                        <p>{d}</p>
                      ))}
                      <a class="link site" href={role.href} rel="noopener">
                        {role.href.replace(/^https?:\/\//, '')}
                      </a>
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a class="line" href={`/projects#${role.slug}`} data-vt-work={role.slug}>
                {cells}
                <svg class="caret" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="m6 3.5 4.5 4.5L6 12.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
          </li>
        )
      })
    }
  </ol>
</div>

<script>
  // Draw the bars once the table is in view.
  const tables = document.querySelectorAll<HTMLElement>('[data-work]')
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        ;(e.target as HTMLElement).dataset.seen = ''
        io.unobserve(e.target)
      }
    },
    { threshold: 0.35 },
  )
  tables.forEach((t) => io.observe(t))

  // Rows that open: one click each, and a link like /projects#google opens
  // that role and lands on it.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-role-toggle]')
  const setOpen = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open))
    document.getElementById(btn.getAttribute('aria-controls') ?? '')?.setAttribute('data-open', String(open))
  }
  toggles.forEach((btn) =>
    btn.addEventListener('click', () => setOpen(btn, btn.getAttribute('aria-expanded') !== 'true')),
  )

  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null
  const btn = target?.querySelector<HTMLButtonElement>('[data-role-toggle]')
  if (target && btn) {
    // Arriving from the home page, the row glides into place first (see the
    // page transition in Layout.astro); the details unfold once it has landed.
    // By the first frame the transition (if any) has started, so look then.
    requestAnimationFrame(() => {
      const landed = (window as { arrival?: Promise<unknown> }).arrival ?? Promise.resolve()
      landed.then(() => {
        setOpen(btn, true)
        target.querySelector('.co')?.classList.add('arrived')
        btn.focus({ preventScroll: true })
      })
    })
  }
</script>

<style>
  .work {
    overflow: hidden;
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    scroll-margin-top: 84px;
  }

  .role + .role,
  .roles {
    border-top: 1px solid var(--line);
  }

  .line {
    display: grid;
    grid-template-columns: minmax(128px, 1fr) minmax(0, 1.3fr) minmax(150px, 1.6fr) 84px 14px;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 0;
    background: none;
    text-align: left;
  }

  a.line,
  button.line {
    cursor: pointer;
    transition: background-color 120ms;
  }

  a.line:hover,
  button.line:hover {
    background: var(--surface-2);
  }

  .head-row {
    min-height: 40px;
    padding-block: 10px;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .axis {
    display: flex;
    justify-content: space-between;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .co {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .what {
    min-width: 0;
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .yrs {
    color: var(--ink-2);
    font-size: 12.5px;
    text-align: right;
  }

  .caret {
    width: 14px;
    height: 14px;
    color: var(--ink-3);
    transition:
      transform 200ms var(--ease),
      color 120ms;
  }

  .line:hover .caret {
    color: var(--ink);
  }

  a.line:hover .caret {
    transform: translateX(2px);
  }

  [aria-expanded='true'] .caret {
    transform: rotate(90deg);
  }

  /* The axis: a hairline with a tick at every new year. */
  .track {
    position: relative;
    height: 16px;
  }

  .track::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    background: linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / calc(100% / var(--span)) 100%
      repeat-x;
  }

  .track::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--line);
  }

  .bar {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: calc(var(--a) * 100%);
    width: calc((var(--b) - var(--a)) * 100%);
    height: 6px;
    margin-top: -3px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink-3) 55%, var(--surface));
    transform-origin: left;
  }

  [data-current] .bar {
    border-radius: 3px 0 0 3px;
    background: var(--blue);
  }

  .tip {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 100%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -6px;
    border-radius: 50%;
    background: var(--blue);
  }

  .tip::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--blue);
    animation: ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* Bars wait for the table to scroll into view, then grow in order. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .work:not([data-seen]) .bar {
      transform: scaleX(0);
    }

    .work:not([data-seen]) .tip {
      opacity: 0;
    }

    .work[data-seen] .bar {
      animation: grow 0.9s var(--ease) var(--delay) both;
    }

    .work[data-seen] .tip {
      animation: appear 0.3s ease-out calc(var(--delay) + 0.75s) both;
    }
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  .detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 280ms var(--ease),
      opacity 200ms ease;
  }

  .detail[data-open='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .clip {
    min-height: 0;
    overflow: hidden;
  }

  .text {
    display: grid;
    gap: 8px;
    max-width: 72ch;
    padding: 2px 16px 18px 46px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.65;
  }

  .site {
    justify-self: start;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .detail[data-open='false'] .text {
    visibility: hidden;
    transition: visibility 0s 280ms;
  }

  @media (max-width: 719px) {
    .head-row {
      display: none;
    }

    .roles {
      border-top: 0;
    }

    .line {
      grid-template-columns: minmax(0, 1fr) auto 14px;
      grid-template-areas:
        'who yrs caret'
        'what what what'
        'track track track';
      gap: 4px 12px;
      padding-block: 14px;
    }

    .who {
      grid-area: who;
    }

    .yrs {
      grid-area: yrs;
    }

    .caret {
      grid-area: caret;
    }

    .what {
      grid-area: what;
      padding-left: 30px;
      white-space: normal;
    }

    .track {
      grid-area: track;
      margin: 8px 0 0 30px;
    }

    .text {
      padding-left: 46px;
    }
  }
</style>
