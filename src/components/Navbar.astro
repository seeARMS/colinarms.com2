---
import { Image } from 'astro:assets'
import avatarImg from '../../public/colin_v1.jpg'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  scrollTitle?: string
  minimal?: boolean
}

const { scrollTitle, minimal } = Astro.props
---

<div
  id="fixed-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm transition-[border-color] duration-300"
>
  <div class="relative px-4 sm:px-6 py-3 flex items-center">
    <!-- Initial state -->
    <div id="nav-initial" class={`absolute inset-0 flex items-center ${minimal ? 'justify-end' : 'justify-start sm:justify-center'} px-4 sm:px-6 transition-opacity duration-300`}>
      {!minimal && (
        <a href="/" class="flex items-center gap-2 text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200">
          <Image
            src={avatarImg}
            alt="Colin Armstrong"
            width={24}
            height={24}
            format="webp"
            quality={80}
            class="rounded-full"
          />
          <span>Colin Armstrong</span>
        </a>
      )}
      <div class={`${minimal ? '' : 'absolute right-4 sm:right-6'} flex items-center gap-1`}>
        <ThemeToggle />
        <button
          class="subscribe-btn shrink-0 text-sm font-medium px-4 py-1.5 rounded-full bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200"
        >
          Subscribe
        </button>
      </div>
    </div>

    {scrollTitle ? (
      <!-- Scrolled state: name left, title center, actions right -->
      <div id="nav-scrolled" class="flex items-center w-full opacity-0 transition-opacity duration-300 pointer-events-none">
        <a href="/" class="flex items-center gap-2 text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200 shrink-0">
          <Image
            src={avatarImg}
            alt="Colin Armstrong"
            width={24}
            height={24}
            format="webp"
            quality={80}
            class="rounded-full"
          />
          <span>Colin Armstrong</span>
        </a>
        <span class="hidden sm:block absolute left-1/2 -translate-x-1/2 text-sm font-medium text-zinc-900 dark:text-zinc-100 truncate max-w-[50%] text-center pointer-events-none">
          {scrollTitle}
        </span>
        <div class="ml-auto flex items-center gap-1">
          <ThemeToggle />
          <button
            class="subscribe-btn shrink-0 text-sm font-medium px-4 py-1.5 rounded-full bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200"
          >
            Subscribe
          </button>
        </div>
      </div>
    ) : (
      <!-- No scroll state: just keep initial visible, use invisible spacer for height -->
      <div class="invisible flex items-center gap-1">
        <div class="h-8 w-8"></div>
        <div class="px-4 py-1.5 text-sm">Subscribe</div>
      </div>
    )}
  </div>
</div>

<script>
  const navScrolled = document.getElementById('nav-scrolled')
  if (navScrolled) {
    const fixedNav = document.getElementById('fixed-nav')!
    const navInitial = document.getElementById('nav-initial')!
    const header = document.getElementById('post-header')!

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          navInitial.classList.remove('opacity-0', 'pointer-events-none')
          navScrolled.classList.add('opacity-0', 'pointer-events-none')
          fixedNav.classList.remove('border-zinc-200', 'dark:border-zinc-700')
          fixedNav.classList.add('border-transparent')
        } else {
          navInitial.classList.add('opacity-0', 'pointer-events-none')
          navScrolled.classList.remove('opacity-0', 'pointer-events-none')
          fixedNav.classList.add('border-zinc-200', 'dark:border-zinc-700')
          fixedNav.classList.remove('border-transparent')
        }
      },
      { threshold: 0 },
    )
    observer.observe(header)
  }
</script>
