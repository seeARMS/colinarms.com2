---
import ThemeToggle from './ThemeToggle.astro'

const currentPath = Astro.url.pathname

const links = [
  { name: 'Home', href: '/' },
  { name: 'Photography', href: '/photography' },
  { name: 'Writing', href: '/writing' },
  { name: 'Contact', href: '/contact' },
]

function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath.startsWith(href)
}
---

<nav
  id="fixed-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-200 dark:border-zinc-700 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm"
>
  <div class="px-4 sm:px-6 py-6 sm:py-3 flex items-center justify-center">
    <!-- Mobile hamburger -->
    <button
      id="nav-hamburger"
      aria-label="Open menu"
      class="absolute left-4 sm:hidden flex flex-col justify-center gap-[5px] w-8 h-8"
    >
      <span class="block w-5 h-[1.5px] bg-zinc-700 dark:bg-zinc-300 transition-all duration-300 origin-center" id="ham-top"></span>
      <span class="block w-5 h-[1.5px] bg-zinc-700 dark:bg-zinc-300 transition-all duration-300" id="ham-mid"></span>
      <span class="block w-5 h-[1.5px] bg-zinc-700 dark:bg-zinc-300 transition-all duration-300 origin-center" id="ham-bot"></span>
    </button>

    <!-- Desktop nav links (centered) -->
    <div class="hidden sm:flex items-center gap-1 text-sm font-medium">
      {links.map((link, i) => (
        <>
          <a
            href={link.href}
            class:list={[
              'px-2 py-1 transition-colors duration-200',
              isActive(link.href)
                ? 'text-zinc-900 dark:text-zinc-100'
                : 'text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100',
            ]}
          >
            {link.name}
          </a>
          {i < links.length - 1 && (
            <span class="text-zinc-300 dark:text-zinc-600 select-none">|</span>
          )}
        </>
      ))}
    </div>

    <!-- Right side actions -->
    <div class="absolute right-4 sm:right-6 flex items-center gap-1">
      <ThemeToggle />
      <button
        class="subscribe-btn shrink-0 text-sm font-medium px-4 py-1.5 rounded-full bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200"
      >
        Subscribe
      </button>
    </div>
  </div>
</nav>

<!-- Mobile full-screen overlay -->
<div
  id="nav-overlay"
  class="fixed inset-0 z-40 bg-white dark:bg-zinc-900 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 sm:hidden"
>
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[
        'text-2xl font-medium transition-colors duration-200',
        isActive(link.href)
          ? 'text-zinc-900 dark:text-zinc-100'
          : 'text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100',
      ]}
    >
      {link.name}
    </a>
  ))}
</div>

<script>
  const hamburger = document.getElementById('nav-hamburger')!
  const overlay = document.getElementById('nav-overlay')!
  const hamTop = document.getElementById('ham-top')!
  const hamMid = document.getElementById('ham-mid')!
  const hamBot = document.getElementById('ham-bot')!
  let isOpen = false

  function toggle() {
    isOpen = !isOpen
    if (isOpen) {
      overlay.classList.remove('opacity-0', 'pointer-events-none')
      overlay.classList.add('opacity-100', 'pointer-events-auto')
      document.body.style.overflow = 'hidden'
      // Animate to X
      hamTop.style.transform = 'translateY(6.5px) rotate(45deg)'
      hamMid.style.opacity = '0'
      hamBot.style.transform = 'translateY(-6.5px) rotate(-45deg)'
    } else {
      overlay.classList.add('opacity-0', 'pointer-events-none')
      overlay.classList.remove('opacity-100', 'pointer-events-auto')
      document.body.style.overflow = ''
      // Animate back to hamburger
      hamTop.style.transform = ''
      hamMid.style.opacity = ''
      hamBot.style.transform = ''
    }
  }

  hamburger.addEventListener('click', toggle)

  // Close overlay on link click
  overlay.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (isOpen) toggle()
    })
  })

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) toggle()
  })
</script>
