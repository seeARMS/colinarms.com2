---
// The top of every page: the wordmark, four places to go, and the theme
// toggle. It sits on the page like a running head rather than floating over it.
import { pagePath } from '@/lib/path'

interface Props {
  /** As wide as a page with a wide grid (Photography). */
  wide?: boolean
}

const { wide = false } = Astro.props
const path = pagePath(Astro.url)

const links = [
  { name: 'Writing', href: '/writing' },
  { name: 'Projects', href: '/projects' },
  { name: 'Photography', href: '/photography' },
  { name: 'Contact', href: '/contact' },
]

const isActive = (href: string) => path.startsWith(href)
---

<header class="nav">
  <div class:list={['container', 'inner', { wide }]}>
    <a href="/" class="home" aria-label="armstr.ng home">armstr<span>.ng</span></a>

    <nav class="links" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.name}
          </a>
        ))
      }
      <button class="theme" type="button" onclick="toggleDarkMode(this)" aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="sun" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="2.75" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
          <path
            d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    view-transition-name: nav;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 30px;
  }

  .home {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .home span {
    color: var(--ink-2);
    font-weight: 400;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    color: var(--ink-2);
    font-size: 17px;
  }

  .links a:hover {
    color: var(--ink);
  }

  /* Where you are: darker, with the ink stroke under it. */
  .links a[aria-current] {
    color: var(--ink);
    background: linear-gradient(var(--blue-faint), var(--blue-faint)) no-repeat left bottom / 100% 1px;
    padding-bottom: 1px;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: -6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
  }

  .theme svg {
    width: 17px;
    height: 17px;
  }

  .theme .sun,
  :global(.dark) .theme .moon {
    display: none;
  }

  :global(.dark) .theme .sun {
    display: block;
  }

  @media (max-width: 639px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-top: 22px;
    }

    .links {
      gap: 4px 16px;
      font-size: 16px;
    }
  }
</style>
