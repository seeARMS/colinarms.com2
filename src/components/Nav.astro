---
import { Image } from 'astro:assets'
import avatar from '@/assets/colin.jpg'
import { pagePath } from '@/lib/path'

const path = pagePath(Astro.url)

const links = [
  { name: 'Projects & Work', href: '/projects' },
  { name: 'Writing', href: '/writing' },
  { name: 'Photography', href: '/photography' },
]

const isActive = (href: string) => path.startsWith(href)
---

<header class="nav">
  <div class="inner">
    <a href="/" class="brand" aria-label="armstr.ng home">
      <Image src={avatar} alt="" width={48} height={48} format="webp" quality={82} class="face" loading="eager" />
      <span class="word">armstr<span>.ng</span></span>
    </a>

    <nav class="links" aria-label="Main" data-links>
      <span class="pill" aria-hidden="true"></span>
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.name}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button class="btn square theme" type="button" onclick="toggleDarkMode()" aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="sun" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="2.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <a class="btn primary" href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
      <button
        class="btn square menu-btn"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-btn
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path class="bar top" d="M2.5 5.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          <path class="bar bottom" d="M2.5 10.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="container menu-links" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.name}
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="m6 3.5 4.5 4.5L6 12.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))
      }
      <button type="button" class="theme-row" onclick="toggleDarkMode()">
        <span>Appearance</span>
        <span class="faint"><span class="when-light">Light</span><span class="when-dark">Dark</span></span>
      </button>
    </nav>
  </div>
</header>

<script>
  // A highlight glides between the links under the pointer. It appears where
  // the pointer first lands (no sliding in from elsewhere) and fades on exit.
  const links = document.querySelector<HTMLElement>('[data-links]')
  const pill = links?.querySelector<HTMLElement>('.pill')
  if (links && pill) {
    let shown = false
    const moveTo = (a: HTMLElement) => {
      pill.style.width = `${a.offsetWidth}px`
      pill.style.transform = `translateX(${a.offsetLeft}px)`
    }
    for (const a of links.querySelectorAll<HTMLElement>('a')) {
      a.addEventListener('pointerenter', () => {
        if (!shown) {
          pill.style.transition = 'none'
          moveTo(a)
          void pill.offsetWidth
          pill.style.transition = ''
          shown = true
        } else {
          moveTo(a)
        }
        links.dataset.hover = ''
      })
    }
    links.addEventListener('pointerleave', () => {
      delete links.dataset.hover
      shown = false
    })
  }

  // Small screens: the links fold into a menu that drops from the bar.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open))
      menu.hidden = !open
    }
    btn.addEventListener('click', () => setOpen(menu.hidden))
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false)
        btn.focus()
      }
    })
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !(e.target as HTMLElement).closest('.nav')) setOpen(false)
    })
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
    view-transition-name: nav;
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: 60px;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    border-radius: var(--radius-sm);
  }

  .face {
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
  }

  .word {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .word span {
    color: var(--ink-3);
  }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .links a {
    position: relative;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-size: 14px;
    transition: color 120ms;
  }

  .links a:hover,
  .links a[aria-current] {
    color: var(--ink);
  }

  .links a[aria-current] {
    font-weight: 500;
  }

  .pill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 30px;
    margin-top: -15px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 260ms var(--ease),
      width 260ms var(--ease),
      opacity 160ms;
  }

  .links[data-hover] .pill {
    opacity: 1;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }

  .theme .sun,
  :global(.dark) .theme .moon {
    display: none;
  }

  :global(.dark) .theme .sun {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  .bar {
    transform-origin: 8px 8px;
    transition: transform 220ms var(--ease);
  }

  [aria-expanded='true'] .top {
    transform: translateY(2.5px) rotate(45deg);
  }

  [aria-expanded='true'] .bottom {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  .menu {
    border-top: 1px solid var(--line);
    animation: drop 0.18s ease-out;
  }

  .menu[hidden] {
    display: none;
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .menu-links {
    display: flex;
    flex-direction: column;
    padding-block: 8px 12px;
  }

  .menu-links a,
  .theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink-2);
    font-size: 16px;
    text-align: left;
    cursor: pointer;
  }

  .menu-links a[aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  .menu-links svg {
    width: 16px;
    height: 16px;
    color: var(--ink-3);
  }

  .theme-row {
    border-bottom: 0;
  }

  .when-dark,
  :global(.dark) .when-light {
    display: none;
  }

  :global(.dark) .when-dark {
    display: inline;
  }

  @media (max-width: 767px) {
    .inner {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    .links,
    .theme {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu {
      animation: none;
    }
  }
</style>
