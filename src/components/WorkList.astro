---
// Where I've worked, as rows: the company's mark, the role, the years. On the
// home page each row links to its full entry; on Projects & Work each row
// opens in place to say more. The job that's still going draws its mark,
// stroke by stroke, the first time the list comes into view.
import Mark from './Mark.astro'
import type { Role } from '@/data/profile'
import { anchor, tenure } from '@/lib/format'

interface Props {
  roles: Role[]
  /** 'link' rows go to the full entry; 'expand' rows open their details. */
  variant?: 'link' | 'expand'
}

const { roles, variant = 'link' } = Astro.props

const rows = roles.map((role) => ({
  ...role,
  slug: anchor(role.company),
  current: role.to === undefined,
  years: tenure(role),
}))
---

<ol class:list={['rows', 'work', variant]} data-work>
  {
    rows.map((role) => {
      const cells = (
        <>
          <span class="who">
            <Mark logo={role.logo} size={22} />
            <span class="names">
              <span class="co">
                <span class="stroke">{role.company}</span>
              </span>
              <span class="what">{role.summary}</span>
            </span>
          </span>
          <span class="yrs">{role.years}</span>
        </>
      )
      return (
        <li class="role" data-role={role.slug} data-current={role.current ? '' : undefined}>
          {variant === 'expand' ? (
            <>
              <button
                class="line"
                type="button"
                aria-expanded="false"
                aria-controls={`${role.slug}-detail`}
                data-role-toggle
                data-vt-work={role.slug}
              >
                {cells}
                <svg class="caret" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="m6 3.5 4.5 4.5L6 12.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="detail" id={`${role.slug}-detail`} data-open="false">
                <div class="clip">
                  <div class="text">
                    {role.details.map((d) => (
                      <p>{d}</p>
                    ))}
                    <a class="link site" href={role.href} rel="noopener">
                      {role.href.replace(/^https?:\/\//, '')}
                    </a>
                  </div>
                </div>
              </div>
            </>
          ) : (
            <a class="line" href={`/projects#${role.slug}`} data-vt-work={role.slug}>
              {cells}
            </a>
          )}
        </li>
      )
    })
  }
</ol>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)')

  // The current job's mark draws itself once the list is in view.
  for (const list of document.querySelectorAll<HTMLElement>('[data-work]')) {
    const strokes = [...list.querySelectorAll<SVGPathElement>('[data-current] .mark svg path')]
    if (!strokes.length || calm.matches || !('IntersectionObserver' in window)) continue
    const lengths = strokes.map((p) => p.getTotalLength())
    strokes.forEach((p, i) => {
      p.style.strokeDasharray = String(lengths[i])
      p.style.strokeDashoffset = String(lengths[i])
    })
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        io.disconnect()
        strokes.forEach((p, i) =>
          p.animate([{ strokeDashoffset: lengths[i] }, { strokeDashoffset: 0 }], {
            duration: 650,
            delay: 250 + i * 220,
            easing: 'cubic-bezier(0.5, 0, 0.2, 1)',
            fill: 'forwards',
          }),
        )
      },
      { threshold: 0.6 },
    )
    io.observe(list)
  }

  // Rows that open: one click each, and a link like /projects#google opens
  // that role and lands on it.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-role-toggle]')
  const setOpen = (btn: HTMLButtonElement, open: boolean) => {
    btn.setAttribute('aria-expanded', String(open))
    document.getElementById(btn.getAttribute('aria-controls') ?? '')?.setAttribute('data-open', String(open))
  }
  toggles.forEach((btn) =>
    btn.addEventListener('click', () => setOpen(btn, btn.getAttribute('aria-expanded') !== 'true')),
  )

  // The page lands at the top of Work (see projects.astro). If the opened
  // entry would then run past the bottom of the screen, as it can on a phone,
  // scroll just enough to show all of it, but never past the row's own top.
  const reveal = (role: HTMLElement) => {
    const { top, bottom } = role.getBoundingClientRect()
    const details = role.querySelector('.clip')?.scrollHeight ?? 0
    const by = Math.min(bottom + details + 24 - innerHeight, top - 32)
    if (by > 0) scrollBy({ top: by, behavior: calm.matches ? 'auto' : 'smooth' })
  }

  const slug = decodeURIComponent(location.hash.slice(1))
  const target = slug ? document.querySelector<HTMLElement>(`[data-role="${CSS.escape(slug)}"]`) : null
  const btn = target?.querySelector<HTMLButtonElement>('[data-role-toggle]')
  if (target && btn) {
    // Arriving from the home page, the row glides into place first (see the
    // page transition in Layout.astro); the details unfold once it has landed.
    // By the first frame the transition (if any) has started, so look then.
    // Wait for the page to finish loading too, or the browser may pull the
    // scroll back to the link's target.
    const loaded = new Promise((done) =>
      document.readyState === 'complete' ? done(null) : addEventListener('load', done, { once: true }),
    )
    requestAnimationFrame(() => {
      const landed = (window as { arrival?: Promise<unknown> }).arrival ?? Promise.resolve()
      Promise.all([landed, loaded]).then(() => {
        reveal(target)
        setOpen(btn, true)
        target.querySelector('.co')?.classList.add('arrived')
      })
    })
  }
</script>

<style>
  .line {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    padding: 13px 0;
    border: 0;
    background: none;
    font-size: 19px;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .who {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    min-width: 0;
  }

  .what {
    color: var(--ink-2);
  }

  .yrs {
    flex: none;
    color: var(--ink-3);
    font-size: 17px;
  }

  button.line:hover .stroke {
    background-position: left bottom;
    background-size: 100% 1px;
    color: var(--blue);
  }

  .caret {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--ink-3);
    transition: transform 220ms var(--ease);
  }

  .line:hover .caret {
    color: var(--ink);
  }

  [aria-expanded='true'] .caret {
    transform: rotate(90deg);
  }

  .detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 280ms var(--ease),
      opacity 200ms ease;
  }

  .detail[data-open='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .clip {
    min-height: 0;
    overflow: hidden;
  }

  .text {
    display: grid;
    gap: 10px;
    padding: 0 0 20px 36px;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .site {
    justify-self: start;
    color: var(--ink);
    font-size: 17px;
  }

  .detail[data-open='false'] .text {
    visibility: hidden;
    transition: visibility 0s 280ms;
  }

  @media (max-width: 639px) {
    .line {
      gap: 16px;
      font-size: 18px;
    }

    .names {
      flex-direction: column;
      gap: 1px;
    }

    .what {
      font-size: 16px;
    }

    .yrs {
      font-size: 15.5px;
    }

    .text {
      padding-left: 36px;
      font-size: 17px;
    }
  }
</style>
