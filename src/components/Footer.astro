---
// The bottom of every page: who and where on the left, the ways to follow
// along on the right.
import { person, socials } from '@/data/profile'

interface Props {
  wide?: boolean
}

const { wide = false } = Astro.props
const shown = socials.filter((s) => s.listed !== false)
---

<footer class="foot" id="site-footer">
  <div class:list={['container', 'inner', { wide }]}>
    <div class="about">
      <a class="brand" href="/">armstr<span>.ng</span></a>
      <p class="made">
        <a class="link mail" href={`mailto:${person.email}`}>{person.email}</a>
        <span class="social">
          {
            shown.map((s) => (
              <a href={s.href} rel="me noopener" aria-label={`Colin on ${s.name}`} title={s.name}>
                <svg viewBox={s.viewBox ?? '0 0 24 24'} aria-hidden="true">
                  <path d={s.icon} />
                </svg>
              </a>
            ))
          }
        </span>
      </p>
    </div>

    <p class="follow">
      <button type="button" class="plain" data-subscribe>Subscribe</button>
      <a class="plain" href="/feed.xml" data-astro-prefetch="false">RSS</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    padding-block: 22px 26px;
    font-size: 15.5px;
  }

  .about {
    display: grid;
    gap: 4px;
  }

  .brand {
    justify-self: start;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--ink-2);
    font-weight: 400;
  }

  .made {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
  }

  .mail {
    color: var(--ink-2);
  }

  .mail:hover {
    color: var(--ink);
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .social a {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--ink-2);
  }

  .social a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
  }

  .social svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .follow {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .plain {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: 16px;
    cursor: pointer;
  }

  .plain:hover {
    color: var(--ink);
  }

  @media (max-width: 639px) {
    .foot {
      margin-top: 88px;
    }

    .inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .social {
      margin-left: -7px;
    }
  }
</style>
