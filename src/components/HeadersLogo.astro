---
// heade.rs's mark: two endpoints and the arc between them. The tile takes the
// text color and the route cuts through in the surface color, so it inverts
// with the theme the way heade.rs's own favicon does.
type Props = {
  size?: number
  class?: string
}

const { size = 24, class: className = '' } = Astro.props
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className}>
  <rect width="24" height="24" rx="6" fill="currentColor"></rect>
  <path
    d="M6.5 16.25C8 8.75 16 8.75 17.5 16.25"
    fill="none"
    stroke="var(--surface)"
    stroke-width="1.9"
    stroke-linecap="round"></path>
  <circle cx="6.5" cy="16.25" r="2.1" fill="var(--surface)"></circle>
  <circle cx="17.5" cy="16.25" r="2.1" fill="var(--surface)"></circle>
</svg>
