---
// A project's or company's logo at a given size. Monochrome marks (Paragraph,
// heade.rs) are drawn inline so they follow the theme; the rest are images.
import HeadersLogo from './HeadersLogo.astro'
import ParagraphLogo from './ParagraphLogo.astro'

interface Props {
  logo: string
  size?: number
}

const { logo, size = 20 } = Astro.props
---

<span class="mark" style={`--size:${size}px`}>
  {
    logo === 'headers' ? (
      <HeadersLogo size={size} />
    ) : logo === 'paragraph' ? (
      <ParagraphLogo size={Math.round(size * 0.9)} />
    ) : (
      <img src={logo} alt="" width={size} height={size} loading="lazy" decoding="async" />
    )
  }
</span>

<style>
  .mark {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    color: var(--ink);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
