---
import { Font } from 'astro:assets'
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Nav from '@/components/Nav.astro'
import SubscribeDialog from '@/components/SubscribeDialog.astro'
import { person } from '@/data/profile'
import { pagePath } from '@/lib/path'

interface Props {
  /** The page's own title; " – Colin Armstrong" is added unless it names him already. */
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  publishedDate?: string
  modifiedDate?: string
  /** schema.org nodes for this page (see src/lib/schema.ts). */
  schema?: object[]
  /** Keep the page out of search results (the 404). */
  noindex?: boolean
  /** Run the header and footer as wide as a page with a wide grid (photos). */
  wide?: boolean
}

const {
  noindex = false,
  title,
  description = person.description,
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
  schema = [],
  wide = false,
} = Astro.props

const GA_MEASUREMENT_ID = 'G-VLG18DVXN5'
const pageTitle = !title
  ? `${person.name} – ${person.title}`
  : title.includes(person.name)
    ? title
    : `${title} – ${person.name}`
const path = pagePath(Astro.url)
const canonicalUrl = new URL(path, Astro.site).href
// The page's Markdown version, for agents (src/pages/*.md.ts, served by src/worker.ts).
const markdownPath = path === '/' ? '/index.md' : `${path}.md`

const imageUrl = new URL(image || '/og/home.png', Astro.site).href

const graph = schema.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }) : undefined
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Colin Armstrong" href="/feed.xml" />
    <meta name="theme-color" content="#fbfbfc" />

    <link rel="preconnect" href="https://public.api.paragraph.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Colin Armstrong" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {type === 'article' && <meta property="article:author" content={Astro.site?.href} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@colinarms" />
    <meta name="twitter:creator" content="@colinarms" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Structured data: one connected graph per page (src/lib/schema.ts) -->
    {graph && <script type="application/ld+json" set:html={graph} />}

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <!-- Arriving from another page on this site, hold the first frame until the
         page's content is in, so the page transition can find what it carries
         across. Arriving from anywhere else (a search result, a shared link),
         nothing transitions, so the page paints as it streams in. -->
    <script is:inline>
      ;(() => {
        const activation = window.navigation?.activation
        const from = activation?.from?.url
        if (!from || activation.navigationType === 'reload') return
        if (new URL(from).origin !== location.origin) return
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const expect = document.createElement('link')
        expect.rel = 'expect'
        expect.href = '#site-footer'
        expect.setAttribute('blocking', 'render')
        document.head.append(expect)
      })()
    </script>

    <!-- Page transitions carry one thing across: the post title you clicked
         grows into the post's heading (and back again), and a Work row glides
         to its place on Projects & Work. Only that element is named, just
         before the swap, so nothing else flies around. -->
    <script is:inline>
      ;(() => {
        if (!('onpagereveal' in window)) return
        let named = []
        const clear = () => {
          named.forEach((el) => (el.style.viewTransitionName = ''))
          named = []
        }
        const name = (el, as) => {
          if (!el) return false
          el.style.viewTransitionName = as
          named.push(el)
          return true
        }
        const isPost = (path) => /^\/writing\/[^/]+$/.test(path)
        const find = (attr, value) => document.querySelector(`[${attr}="${CSS.escape(value)}"]`)

        // The same choice on both pages, from the addresses alone: the post
        // being opened (its title grows), else the post being left (its title
        // shrinks back into the list), else the Work role asked for.
        function pair(fromHref, toHref) {
          clear()
          const from = new URL(fromHref)
          const to = new URL(toHref)
          if (isPost(to.pathname) && name(find('data-vt-post', to.pathname), 'post-title')) return 'grow'
          if (isPost(from.pathname) && name(find('data-vt-post', from.pathname), 'post-title')) return 'shrink'
          const role = (to.pathname === '/projects' && to.hash) || (from.pathname === '/projects' && from.hash)
          if (role && name(find('data-vt-work', decodeURIComponent(role.slice(1))), 'work-row')) return 'work'
        }

        addEventListener('pageswap', (e) => {
          if (e.viewTransition && e.activation) pair(location.href, e.activation.entry.url)
        })

        addEventListener('pagereveal', (e) => {
          const from = window.navigation?.activation?.from?.url
          if (!e.viewTransition || !from) return
          const root = document.documentElement
          const move = pair(from, location.href)
          if (move) root.dataset.move = move
          // Whatever should wait for the page to settle (a Work entry
          // unfolding) can wait on this.
          window.arrival = e.viewTransition.finished.catch(() => {})
          window.arrival.then(() => {
            clear()
            delete root.dataset.move
          })
        })
      })()
    </script>

    <!-- Before first paint: pick the theme, so the page never flashes. -->
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const media = matchMedia('(prefers-color-scheme: dark)')
        let memory = null
        const read = () => {
          try {
            return localStorage.getItem('theme')
          } catch {
            return memory
          }
        }
        const write = (value) => {
          memory = value
          try {
            localStorage.setItem('theme', value)
          } catch {}
        }

        const apply = () => {
          const saved = read()
          const dark = saved === 'dark' || (!saved && media.matches)
          root.classList.toggle('dark', dark)
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#171716' : '#fbfbfc')
        }

        // Swap every color at once, rather than each element easing on its own.
        const applyQuietly = () => {
          root.classList.add('no-transitions')
          apply()
          requestAnimationFrame(() =>
            requestAnimationFrame(() => root.classList.remove('no-transitions')),
          )
        }

        apply()
        media.addEventListener('change', applyQuietly)

        // The new theme spreads out from the toggle like ink into paper. The
        // circle is set in percentages of the page, which hold however the
        // snapshot is scaled (a percentage radius is of the diagonal over √2).
        window.toggleDarkMode = (from) => {
          write(root.classList.contains('dark') ? 'light' : 'dark')
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
          if (!document.startViewTransition || calm) return applyQuietly()
          const box = from?.getBoundingClientRect?.()
          const x = box ? box.left + box.width / 2 : innerWidth - 40
          const y = box ? box.top + box.height / 2 : 40
          const reach = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
          const radius = (reach / (Math.hypot(innerWidth, innerHeight) / Math.SQRT2)) * 100
          const at = `${(x / innerWidth) * 100}% ${(y / innerHeight) * 100}%`
          root.dataset.themeSwap = ''
          const swap = document.startViewTransition(applyQuietly)
          swap.ready.then(() =>
            root.animate(
              { clipPath: [`circle(0% at ${at})`, `circle(${radius}% at ${at})`] },
              { duration: 720, easing: 'cubic-bezier(0.3, 0.6, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
            ),
          )
          swap.finished.finally(() => delete root.dataset.themeSwap)
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Nav wide={wide} />
    <main id="content">
      <slot />
    </main>
    <Footer wide={wide} />
    <SubscribeDialog />

    <!-- Google Analytics (deferred) -->
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        // eslint-disable-next-line prefer-rest-params -- gtag.js needs the arguments object itself, not an array
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', GA_MEASUREMENT_ID, { page_path: window.location.pathname })
      const s = document.createElement('script')
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID
      s.async = true
      document.body.appendChild(s)
    </script>
  </body>
</html>
