---
import { Font, getImage } from 'astro:assets'
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Nav from '@/components/Nav.astro'
import SubscribeDialog from '@/components/SubscribeDialog.astro'
import avatar from '@/assets/colin.jpg'
import { person, socials } from '@/data/profile'
import { pagePath } from '@/lib/path'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  publishedDate?: string
  isHomepage?: boolean
  /** Keep the page out of search results (the 404). */
  noindex?: boolean
}

const {
  noindex = false,
  title,
  description = `${person.title}, the media engine for early-stage startups. ${person.previously}.`,
  image,
  type = 'website',
  publishedDate,
  isHomepage = false,
} = Astro.props

const GA_MEASUREMENT_ID = 'G-VLG18DVXN5'
const pageTitle = title ? `${title} – ${person.name}` : `${person.name} – ${person.title}`
const canonicalUrl = new URL(pagePath(Astro.url), Astro.site).href

const imageUrl = new URL(image || '/og/home.png', Astro.site).href

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: person.name,
  url: Astro.site?.href,
})

const portrait = isHomepage ? await getImage({ src: avatar, width: 400, height: 400, format: 'jpg' }) : undefined
const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: Astro.site?.href,
  image: portrait && new URL(portrait.src, Astro.site).href,
  description: `${person.title}, the media engine for early-stage startups. Previously led anti-abuse and privacy engineering at Google and helped build Coinbase's payments infrastructure.`,
  jobTitle: 'Founder & CEO',
  worksFor: {
    '@type': 'Organization',
    name: 'Paragraph',
    url: 'https://paragraph.com',
  },
  sameAs: socials.map((s) => s.href),
})

const articleSchema =
  type === 'article' && title
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        datePublished: publishedDate,
        author: {
          '@type': 'Person',
          name: person.name,
          url: Astro.site?.href,
        },
      })
    : null
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Colin Armstrong" href="/feed.xml" />
    <meta name="theme-color" content="#fafafa" />

    <link rel="preconnect" href="https://public.api.paragraph.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Colin Armstrong" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@colinarms" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={websiteSchema} />
    {isHomepage && <script type="application/ld+json" set:html={personSchema} />}
    {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}

    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <!-- Before first paint: pick the theme, so the page never flashes. -->
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const media = matchMedia('(prefers-color-scheme: dark)')
        let memory = null
        const read = () => {
          try {
            return localStorage.getItem('theme')
          } catch {
            return memory
          }
        }
        const write = (value) => {
          memory = value
          try {
            localStorage.setItem('theme', value)
          } catch {}
        }

        const apply = () => {
          const saved = read()
          const dark = saved === 'dark' || (!saved && media.matches)
          root.classList.toggle('dark', dark)
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#0a0a0a' : '#fafafa')
        }

        // Swap every color at once, rather than each element easing on its own.
        const applyQuietly = () => {
          root.classList.add('no-transitions')
          apply()
          requestAnimationFrame(() =>
            requestAnimationFrame(() => root.classList.remove('no-transitions')),
          )
        }

        apply()
        media.addEventListener('change', applyQuietly)

        window.toggleDarkMode = () => {
          write(root.classList.contains('dark') ? 'light' : 'dark')
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
          if (document.startViewTransition && !calm) {
            root.dataset.themeSwap = ''
            document
              .startViewTransition(applyQuietly)
              .finished.finally(() => delete root.dataset.themeSwap)
          } else {
            applyQuietly()
          }
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Nav />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <SubscribeDialog />

    <!-- Google Analytics (deferred) -->
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', GA_MEASUREMENT_ID, { page_path: window.location.pathname })
      var s = document.createElement('script')
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID
      s.async = true
      document.body.appendChild(s)
    </script>
  </body>
</html>
