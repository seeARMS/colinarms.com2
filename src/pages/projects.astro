---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import Mark from '@/components/Mark.astro'
import WorkTimeline from '@/components/WorkTimeline.astro'
import { appearances, projects, work } from '@/data/profile'
import { breadcrumbs } from '@/lib/schema'

const since = Math.min(...work.map((role) => role.from))
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const when = (ym: string) => {
  const [y, m] = ym.split('-').map(Number)
  return `${MONTHS[m - 1]} ${y}`
}
---

<Layout
  title="Projects, work and press"
  description="Colin Armstrong's side projects (heade.rs, Draftside, Council), his work at Paragraph, Mirror, Google and Coinbase, and his podcast and press appearances."
  schema={[breadcrumbs([{ name: 'Projects & Work', path: '/projects' }])]}
>
  <div class="container">
    <header class="page-head">
      <h1>Projects & Work</h1>
      <p class="summary">What I'm building on the side, where I've worked, and where I've talked about it.</p>
    </header>

    <section class="section" aria-labelledby="projects">
      <div class="section-head">
        <h2 id="projects">Projects</h2>
        <span class="meta">Small products & experiments I've built</span>
      </div>
      <ul class="grid">
        {
          projects.map((project) => (
            <li>
              <a class="card project" href={project.href} rel="noopener">
                <span class="top">
                  <Mark logo={project.logo} size={28} />
                  <svg class="out" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M5 11 11 5M6 5h5v5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="name">{project.name}</span>
                <span class="domain mono">{project.href.replace(/^https?:\/\//, '')}</span>
                <span class="about">{project.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="work">
      <div class="section-head">
        <h2 id="work">Work</h2>
        <span class="meta">Since {since}</span>
      </div>
      <p class="lead muted">
        Selected roles where I worked on payments, anti-abuse, privacy, and systems that reached large numbers of
        people.
      </p>
      <WorkTimeline roles={work} variant="expand" />
    </section>

    <section class="section" aria-labelledby="press">
      <div class="section-head">
        <h2 id="press">Podcasts & press</h2>
      </div>
      <ol class="card press">
        {
          appearances.map((a) => (
            <li>
              <a href={a.href} rel="noopener">
                <span class="outlet">{a.outlet}</span>
                <span class="title">{a.title}</span>
                <span class="kind">{a.kind}</span>
                <time class="date mono num" datetime={a.date}>
                  {when(a.date)}
                </time>
                <svg class="go" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M5 11 11 5M6 5h5v5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 18px 20px 20px;
    transition: border-color 120ms;
  }

  .project:hover {
    border-color: var(--line-strong);
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .top :global(.mark) {
    transition: transform 240ms var(--ease);
  }

  .project:hover .top :global(.mark) {
    transform: translateY(-2px);
  }

  .out,
  .go {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--ink-3);
    transition:
      transform 160ms var(--ease),
      color 120ms;
  }

  .project:hover .out,
  .press a:hover .go {
    color: var(--ink);
    transform: translate(1px, -1px);
  }

  .name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .domain {
    margin-top: 2px;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .about {
    margin-top: 10px;
    color: var(--ink-2);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .lead {
    max-width: 64ch;
    margin: -4px 0 16px;
    font-size: 15px;
    line-height: 1.6;
  }

  /* Podcasts & press: the same rows as the writing list. */
  .press {
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
  }

  .press li + li {
    border-top: 1px solid var(--line);
  }

  .press a {
    display: grid;
    grid-template-columns: minmax(120px, 0.7fr) minmax(0, 2fr) 72px 72px 16px;
    align-items: center;
    gap: 16px;
    min-height: 48px;
    padding: 12px 16px;
    transition: background-color 120ms;
  }

  .press a:hover {
    background: var(--surface-2);
  }

  .outlet {
    color: var(--ink-2);
  }

  .title {
    min-width: 0;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .kind {
    justify-self: end;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 500;
  }

  .date {
    color: var(--ink-3);
    font-size: 12.5px;
    text-align: right;
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .top {
      margin-bottom: 14px;
    }
  }

  @media (max-width: 639px) {
    .press a {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'outlet date'
        'title title';
      gap: 2px 12px;
      padding-block: 13px;
    }

    .outlet {
      grid-area: outlet;
      font-size: 13px;
    }

    .date {
      grid-area: date;
    }

    .title {
      grid-area: title;
    }

    .kind,
    .go {
      display: none;
    }
  }
</style>
