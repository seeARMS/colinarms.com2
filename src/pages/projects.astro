---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import Mark from '@/components/Mark.astro'
import WorkList from '@/components/WorkList.astro'
import { appearances, projects, work } from '@/data/profile'
import { breadcrumbs } from '@/lib/schema'

const since = Math.min(...work.map((role) => role.from))
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const when = (ym: string) => {
  const [y, m] = ym.split('-').map(Number)
  return `${MONTHS[m - 1]} ${y}`
}
// Where each appearance ran, said the way you'd say it.
const where = (a: (typeof appearances)[number]) =>
  a.kind === 'Podcast' ? `On ${a.outlet}` : a.kind === 'Interview' ? `Interviewed by ${a.outlet}` : `In ${a.outlet}`
const out = 'M5 11 11 5M6 5h5v5'
---

<Layout
  title="Projects, work and press"
  description="Colin Armstrong's side projects (heade.rs, Draftside, Council), his work at Paragraph, Mirror, Google and Coinbase, and his podcast and press appearances."
  schema={[breadcrumbs([{ name: 'Projects & Work', path: '/projects' }])]}
>
  <div class="container">
    <header class="page-head">
      <h1>Projects & Work</h1>
      <p class="summary">What I'm building on the side, where I've worked, and where I've talked about it.</p>
    </header>

    <section class="section" aria-labelledby="projects">
      <div class="section-head">
        <h2 id="projects">Projects</h2>
        <span class="meta">Small products & experiments I've built</span>
      </div>
      <ul class="rows">
        {
          projects.map((project) => (
            <li>
              <a class="project" href={project.href} rel="noopener">
                <Mark logo={project.logo} size={26} />
                <span class="text">
                  <span class="name">
                    <span class="stroke">{project.name}</span>
                  </span>
                  <span class="about">{project.summary}</span>
                </span>
                <span class="domain">
                  {project.href.replace(/^https?:\/\//, '')}
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d={out}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="work">
      <div class="section-head">
        <h2 id="work">Work</h2>
        <span class="meta">Since {since}</span>
      </div>
      <p class="lead">
        Selected roles where I worked on payments, anti-abuse, privacy, and systems that reached large numbers of
        people.
      </p>
      <WorkList roles={work} variant="expand" />
    </section>

    <section class="section" aria-labelledby="press">
      <div class="section-head">
        <h2 id="press">Podcasts & press</h2>
      </div>
      <ol class="rows">
        {
          appearances.map((a) => (
            <li>
              <a class="appearance" href={a.href} rel="noopener">
                <span class="text">
                  <span class="title">
                    <span class="stroke">{a.title}</span>
                  </span>
                  <span class="where">{where(a)}</span>
                </span>
                <time class="date" datetime={a.date}>
                  {when(a.date)}
                </time>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  .project {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
  }

  .text {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }

  .name {
    font-size: 20px;
    line-height: 1.3;
  }

  .about {
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .domain {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    color: var(--ink-3);
    font-size: 16px;
  }

  .domain svg {
    width: 15px;
    height: 15px;
    transition: transform 220ms var(--ease);
  }

  .project:hover .domain {
    color: var(--ink);
  }

  .project:hover .domain svg {
    transform: translate(2px, -2px);
  }

  .lead {
    max-width: 34em;
    margin: 18px 0 6px;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .lead + :global(.work) {
    border-top: 1px solid var(--line);
  }

  .appearance {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 13px 0;
  }

  .title {
    font-size: 19px;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .where {
    color: var(--ink-2);
    font-size: 16px;
  }

  .date {
    flex: none;
    margin-left: auto;
    color: var(--ink-3);
    font-size: 16px;
  }

  @media (max-width: 639px) {
    .project {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 4px 14px;
    }

    .project :global(.mark) {
      margin-top: 2px;
    }

    .text {
      flex-basis: calc(100% - 40px);
    }

    .domain {
      margin-left: 40px;
      font-size: 15px;
    }

    .name {
      font-size: 19px;
    }

    .about {
      font-size: 16px;
    }

    .appearance {
      gap: 16px;
    }

    .title {
      font-size: 18px;
    }

    .where,
    .date {
      font-size: 15px;
    }
  }
</style>
