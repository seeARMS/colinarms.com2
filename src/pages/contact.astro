---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import { person, socials } from '@/data/profile'
---

<Layout
  title="Contact"
  description="Get in touch with Colin Armstrong. Founders building something early are especially welcome."
>
  <div class="container narrow">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="summary">
        I especially like hearing from founders building something early. Email is the best way to reach me: send a few
        lines on what you're building, who it's for, and where I could help.
      </p>
    </header>

    <ul class="card rows ways">
      <li class="row">
        <span class="name">
          <svg viewBox="0 0 16 16" aria-hidden="true" class="line-icon">
            <rect x="2" y="3.5" width="12" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"
            ></rect>
            <path
              d="m2.75 4.5 5.25 4 5.25-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"></path>
          </svg>
          Email
        </span>
        <a class="handle mono" href={`mailto:${person.email}`}>{person.email}</a>
        <span class="actions">
          <button class="btn copy" type="button" data-copy={person.email}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="5.25" y="5.25" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"
              ></rect>
              <path
                d="M10.75 5.25V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5.25a1.5 1.5 0 0 0 1.5 1.5h1.25"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"></path>
            </svg>
            <span data-label>Copy</span>
          </button>
        </span>
      </li>
      {
        socials.map((s) => (
          <li class="row">
            <span class="name">
              <svg viewBox={s.viewBox ?? '0 0 24 24'} aria-hidden="true" class="fill-icon">
                <path d={s.icon} />
              </svg>
              {s.name}
            </span>
            <a class="handle mono" href={s.href} rel="me noopener">
              {s.handle}
            </a>
            <span class="actions">
              <svg class="out" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M5 11 11 5M6 5h5v5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.querySelector('[data-label]')
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '')
        if (label) {
          label.textContent = 'Copied'
          setTimeout(() => (label.textContent = 'Copy'), 1600)
        }
      } catch {
        // Clipboard blocked: the address is still there to select.
      }
    })
  }
</script>

<style>
  .narrow {
    max-width: calc(720px + var(--gutter) * 2);
  }

  .ways {
    margin-top: 32px;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 16px;
    min-height: 56px;
    transition: background-color 120ms;
  }

  .row:hover {
    background: var(--surface-2);
  }

  .row:first-child {
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .row:last-child {
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
  }

  .line-icon,
  .fill-icon {
    width: 16px;
    height: 16px;
    color: var(--ink-3);
  }

  .fill-icon {
    width: 14px;
    height: 14px;
    margin-inline: 1px;
    fill: currentColor;
  }

  .handle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13.5px;
  }

  /* The whole row is the link; the copy button sits above it. */
  .handle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .actions {
    display: inline-flex;
    justify-content: flex-end;
    align-items: center;
  }

  .copy {
    position: relative;
    z-index: 1;
    height: 28px;
    padding: 0 10px;
    font-size: 13px;
  }

  .copy svg {
    width: 14px;
    height: 14px;
  }

  .out {
    width: 16px;
    height: 16px;
    color: var(--ink-3);
    transition:
      transform 160ms var(--ease),
      color 120ms;
  }

  .row:hover .out {
    color: var(--ink);
    transform: translate(1px, -1px);
  }

  @media (max-width: 519px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px 12px;
      padding-block: 12px;
    }

    .name {
      grid-column: 1;
    }

    .handle {
      grid-column: 1;
      grid-row: 2;
    }

    .actions {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
