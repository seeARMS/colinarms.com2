---
export const prerender = true

import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import Footer from '@/components/Footer.astro'
import Navbar from '@/components/Navbar.astro'
import SubscribeDialog from '@/components/SubscribeDialog.astro'

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true },
)

const photos = Object.entries(imageModules)
  .map(([path, mod]) => ({
    name: path.replace(/.*\//, '').replace(/\.[^.]+$/, ''),
    image: mod.default,
  }))
  .sort((a, b) => a.name.localeCompare(b.name))
---

<Layout title="Photography" description="Wildlife, landscape, and astrophotography by Colin Armstrong." image="/photos/yosemite.jpg">
  <Navbar />
  <SubscribeDialog />

  <div class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-16 sm:pt-24 sm:pb-24">

      <div id="photo-grid" class="columns-2 md:columns-3 lg:columns-4 gap-3 space-y-3">
        {photos.map((photo) => {
          const delay = (Math.random() * 0.8).toFixed(2)
          return (
            <button
              class="photo-thumb block w-full break-inside-avoid cursor-zoom-in overflow-hidden rounded-lg opacity-[0.01] animate-fade-in"
              style={`animation-delay: ${delay}s`}
            >
              <Image
                src={photo.image}
                alt=""
                widths={[400, 800, 1080]}
                sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
                class="w-full block"
              />
            </button>
          )
        })}
      </div>
    </div>
  </div>

  <Footer />

  <!-- Lightbox: frosted glass with FLIP animation -->
  <div id="lightbox" class="fixed inset-0 z-[100] pointer-events-none" style="opacity:0">
    <!-- Frosted page blur layer -->
    <div id="lb-frost" class="absolute inset-0 backdrop-blur-xl bg-white/60 dark:bg-zinc-900/70"></div>

    <!-- Photo container -->
    <img id="lb-img" class="absolute rounded-lg shadow-2xl" src="" alt="" />

    <!-- Minimal UI -->
    <div id="lb-ui" class="absolute inset-x-0 bottom-0 flex items-end justify-between px-6 pb-6 opacity-0 transition-opacity duration-500 pointer-events-none">
      <span id="lb-counter" class="text-xs tracking-widest text-zinc-500 dark:text-zinc-400 font-mono tabular-nums"></span>
      <span class="text-xs text-zinc-400 dark:text-zinc-500">esc to close &middot; arrows to browse</span>
    </div>
  </div>

  <style>
    #lightbox.is-open { pointer-events: auto; }
    #lb-img { transition: none; transform-origin: 0 0; }
    #lb-img.animating {
      transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1),
                  border-radius 0.4s cubic-bezier(0.32, 0.72, 0, 1),
                  opacity 0.25s ease;
    }
    #lb-frost {
      transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity;
      transform: translateZ(0);
    }
    #lightbox {
      transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity;
    }
    .photo-thumb.is-active img {
      opacity: 0;
    }
  </style>

  <script>
    const grid = document.getElementById('photo-grid')!
    const thumbs = Array.from(grid.children) as HTMLElement[]
    for (let i = thumbs.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[thumbs[i], thumbs[j]] = [thumbs[j], thumbs[i]]
    }
    const frag = document.createDocumentFragment()
    thumbs.forEach((t) => frag.appendChild(t))
    grid.appendChild(frag)

    const lightbox = document.getElementById('lightbox')!
    const frost = document.getElementById('lb-frost')!
    const lbImg = document.getElementById('lb-img') as HTMLImageElement
    const lbUI = document.getElementById('lb-ui')!
    const lbCounter = document.getElementById('lb-counter')!
    const thumbList = Array.from(document.querySelectorAll('.photo-thumb')) as HTMLElement[]

    // Pre-warm the backdrop-filter shader so the first open isn't a cold start.
    requestAnimationFrame(() => {
      lightbox.style.transition = 'none'
      lightbox.style.opacity = '0.001'
      lightbox.getBoundingClientRect() // force paint
      requestAnimationFrame(() => {
        lightbox.style.opacity = '0'
        requestAnimationFrame(() => {
          lightbox.style.transition = ''
        })
      })
    })
    let currentIndex = -1
    let isOpen = false
    let dragStartY = 0
    let dragY = 0
    let isDragging = false
    let pendingTimeouts: number[] = []

    function cancelPending() {
      pendingTimeouts.forEach((id) => clearTimeout(id))
      pendingTimeouts = []
    }

    function getFullSrc(thumb: HTMLElement) {
      const img = thumb.querySelector('img')!
      const srcset = img.getAttribute('srcset')
      return srcset ? srcset.split(',').pop()!.trim().split(' ')[0] : img.src
    }

    function getFinalRect(img: HTMLImageElement) {
      const vw = window.innerWidth * 0.92
      const vh = window.innerHeight * 0.88
      const naturalW = img.naturalWidth || 1080
      const naturalH = img.naturalHeight || 810
      const scale = Math.min(vw / naturalW, vh / naturalH)
      const w = naturalW * scale
      const h = naturalH * scale
      return {
        left: (window.innerWidth - w) / 2,
        top: (window.innerHeight - h) / 2,
        width: w,
        height: h,
      }
    }

    type Rect = { left: number; top: number; width: number; height: number }

    function setFinalRect(rect: Rect) {
      lbImg.style.left = rect.left + 'px'
      lbImg.style.top = rect.top + 'px'
      lbImg.style.width = rect.width + 'px'
      lbImg.style.height = rect.height + 'px'
    }

    function getCurrentFinalRect(): Rect {
      return {
        left: parseFloat(lbImg.style.left),
        top: parseFloat(lbImg.style.top),
        width: parseFloat(lbImg.style.width),
        height: parseFloat(lbImg.style.height),
      }
    }

    function inverseTransform(thumbRect: Rect, finalRect: Rect) {
      const dx = thumbRect.left - finalRect.left
      const dy = thumbRect.top - finalRect.top
      const sx = thumbRect.width / finalRect.width
      const sy = thumbRect.height / finalRect.height
      return `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`
    }

    function open(index: number) {
      // Interrupt any in-progress close: cancel timeouts and restore the
      // previously-active thumb so the grid is consistent.
      cancelPending()
      if (currentIndex >= 0 && currentIndex !== index) {
        thumbList[currentIndex].classList.remove('is-active')
      }
      // Clear any inline transition left over from drag-dismiss.
      lbImg.style.transition = ''

      currentIndex = index
      const thumb = thumbList[index]
      const thumbImg = thumb.querySelector('img')!
      const thumbRect = thumbImg.getBoundingClientRect()

      thumb.classList.add('is-active')

      lbImg.src = getFullSrc(thumb)
      lbImg.classList.remove('animating')

      // Place lb-img at its final centered rect, then apply an inverse
      // transform so it visually matches the thumbnail (FLIP technique).
      const final = getFinalRect(thumbImg)
      setFinalRect(final)
      lbImg.style.transformOrigin = '0 0'
      lbImg.style.transform = inverseTransform(thumbRect, final)
      lbImg.style.borderRadius = '0.5rem'
      lbImg.style.opacity = '1'
      lbImg.style.willChange = 'transform'

      lightbox.style.opacity = '1'
      lightbox.classList.add('is-open')
      isOpen = true
      document.body.style.overflow = 'hidden'

      // Force reflow, then animate to identity transform.
      lbImg.getBoundingClientRect()
      requestAnimationFrame(() => {
        lbImg.classList.add('animating')
        lbImg.style.transform = ''
        lbImg.style.borderRadius = '0.25rem'
      })

      pendingTimeouts.push(setTimeout(() => {
        lbUI.style.opacity = '1'
        lbUI.classList.add('pointer-events-auto')
        lbImg.style.willChange = ''
      }, 500))

      lbCounter.textContent = `${index + 1} / ${thumbList.length}`
    }

    function close() {
      if (!isOpen) return
      cancelPending()
      // Drop pointer-events immediately so the grid underneath is clickable
      // again right when the user dismisses, not after the morph finishes.
      isOpen = false
      lightbox.classList.remove('is-open')

      const thumb = thumbList[currentIndex]
      const closingIndex = currentIndex
      const thumbImg = thumb.querySelector('img')!
      const thumbRect = thumbImg.getBoundingClientRect()
      const final = getCurrentFinalRect()

      lbUI.style.opacity = '0'
      lbUI.classList.remove('pointer-events-auto')

      lbImg.style.willChange = 'transform'
      lbImg.style.transformOrigin = '0 0'
      lbImg.classList.add('animating')
      lbImg.style.transform = inverseTransform(thumbRect, final)
      lbImg.style.borderRadius = '0.5rem'

      pendingTimeouts.push(setTimeout(() => {
        thumb.classList.remove('is-active')
        lightbox.style.opacity = '0'
      }, 420))

      pendingTimeouts.push(setTimeout(() => {
        // Only finalize if no new open() has taken over (which would have
        // bumped currentIndex away from closingIndex).
        if (currentIndex === closingIndex) currentIndex = -1
        document.body.style.overflow = ''
        lbImg.classList.remove('animating')
        lbImg.style.transform = ''
        lbImg.style.willChange = ''
      }, 750))
    }

    function navigate(dir: number) {
      if (!isOpen) return
      cancelPending()
      const nextIndex = (currentIndex + dir + thumbList.length) % thumbList.length
      const prevThumb = thumbList[currentIndex]

      // Fade + subtle scale-down on the way out.
      lbImg.style.transformOrigin = '50% 50%'
      lbImg.style.willChange = 'transform, opacity'
      lbImg.classList.add('animating')
      lbImg.style.transform = 'scale(0.97)'
      lbImg.style.opacity = '0'

      pendingTimeouts.push(setTimeout(() => {
        prevThumb.classList.remove('is-active')
        currentIndex = nextIndex
        const nextThumb = thumbList[nextIndex]
        const nextThumbImg = nextThumb.querySelector('img')!
        nextThumb.classList.add('is-active')

        lbImg.src = getFullSrc(nextThumb)
        lbImg.classList.remove('animating')

        // Reposition at the new image's final rect, start slightly larger + transparent.
        const final = getFinalRect(nextThumbImg)
        setFinalRect(final)
        lbImg.style.transform = 'scale(1.03)'
        lbImg.style.opacity = '0'

        lbImg.getBoundingClientRect()
        requestAnimationFrame(() => {
          lbImg.classList.add('animating')
          lbImg.style.transform = ''
          lbImg.style.opacity = '1'
        })

        pendingTimeouts.push(setTimeout(() => {
          lbImg.style.willChange = ''
        }, 400))

        lbCounter.textContent = `${nextIndex + 1} / ${thumbList.length}`
      }, 200))
    }

    // Drag to dismiss
    lbImg.addEventListener('pointerdown', (e) => {
      if (!isOpen) return
      isDragging = true
      dragStartY = e.clientY
      dragY = 0
      lbImg.classList.remove('animating')
      lbImg.style.transformOrigin = '50% 50%'
      lbImg.style.willChange = 'transform'
      lbImg.setPointerCapture(e.pointerId)
      lbImg.style.cursor = 'grabbing'
    })

    lbImg.addEventListener('pointermove', (e) => {
      if (!isDragging) return
      dragY = e.clientY - dragStartY
      const progress = Math.min(Math.abs(dragY) / 300, 1)
      lbImg.style.transform = `translateY(${dragY}px) scale(${1 - progress * 0.15})`
      frost.style.opacity = String(1 - progress * 0.6)
    })

    lbImg.addEventListener('pointerup', () => {
      if (!isDragging) return
      isDragging = false
      lbImg.style.cursor = ''

      if (Math.abs(dragY) > 120) {
        // Dismiss: immediately drop pointer-events so the grid is clickable.
        cancelPending()
        isOpen = false
        lightbox.classList.remove('is-open')
        const dismissedIndex = currentIndex

        lbImg.style.transition = 'transform 0.3s ease, opacity 0.3s ease'
        lbImg.style.transform = `translateY(${dragY > 0 ? 400 : -400}px) scale(0.8)`
        lbImg.style.opacity = '0'
        frost.style.transition = 'opacity 0.3s ease'
        frost.style.opacity = '0'
        pendingTimeouts.push(setTimeout(() => {
          lightbox.style.opacity = '0'
          pendingTimeouts.push(setTimeout(() => {
            thumbList[dismissedIndex]?.classList.remove('is-active')
            if (currentIndex === dismissedIndex) currentIndex = -1
            document.body.style.overflow = ''
            lbImg.style.transform = ''
            lbImg.style.opacity = ''
            lbImg.style.transition = ''
            lbImg.style.willChange = ''
            frost.style.opacity = ''
            frost.style.transition = ''
            lbImg.classList.remove('animating')
          }, 300))
        }, 100))
      } else {
        // Snap back
        lbImg.style.transition = 'transform 0.4s cubic-bezier(0.32, 0.72, 0, 1)'
        lbImg.style.transform = ''
        frost.style.opacity = '1'
        setTimeout(() => {
          lbImg.style.transition = ''
          lbImg.style.willChange = ''
        }, 400)
      }
    })

    // Click grid items
    thumbList.forEach((thumb, i) => {
      thumb.addEventListener('click', () => open(i))
    })

    // Click frost to close
    frost.addEventListener('click', close)

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (!isOpen) return
      if (e.key === 'Escape') close()
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1)
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigate(-1)
    })
  </script>
</Layout>
