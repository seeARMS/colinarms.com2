---
export const prerender = true

import { Image, getImage } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import meta from 'virtual:photo-meta'
import { captions } from '@/data/photos'
import { breadcrumbs, imageGallery } from '@/lib/schema'

const modules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp}', {
  eager: true,
})

const photos = await Promise.all(
  Object.entries(modules)
    .map(([path, mod]) => ({
      name: path.replace(/.*\//, '').replace(/\.[^.]+$/, ''),
      image: mod.default,
    }))
    .sort((a, b) => a.name.localeCompare(b.name))
    .map(async ({ name, image }) => {
      // The lightbox gets its own large copy, so photos stay sharp on big screens.
      const full = await getImage({ src: image, width: Math.min(2400, image.width), format: 'webp', quality: 82 })
      const m = meta[name] ?? {}
      return {
        name,
        image,
        full: full.src,
        caption: captions[name],
        date: m.date,
        chips: [m.camera, m.lens, m.focal, m.aperture, m.shutter, m.iso].filter(Boolean) as string[],
      }
    }),
)

// "mostly on a Canon EOS R5", from the photos themselves.
const counts = new Map<string, number>()
for (const p of photos) if (p.chips[0]) counts.set(p.chips[0], (counts.get(p.chips[0]) ?? 0) + 1)
const camera = [...counts].sort((a, b) => b[1] - a[1])[0]?.[0]
---

<Layout
  title="Wildlife, landscape & astrophotography"
  description="Photographs by Colin Armstrong: birds, bobcats and howler monkeys, the Milky Way, Patagonia, Yosemite, Santorini and Big Sur, mostly shot on a Canon EOS R5."
  image="/photos/yosemite.jpg"
  schema={[
    imageGallery(photos.map((p) => ({ src: p.full, caption: p.caption }))),
    breadcrumbs([{ name: 'Photography', path: '/photography' }]),
  ]}
>
  <div class="container wide">
    <header class="page-head">
      <h1>Photography</h1>
      <p class="summary">
        Wildlife, landscape, and astrophotography{camera && <>, mostly on a {camera}</>}. Open any photo to see how it was
        taken.
      </p>
    </header>

    <div class="grid" data-grid>
      {
        photos.map((p) => (
          <button
            class="thumb"
            type="button"
            data-full={p.full}
            data-w={p.image.width}
            data-h={p.image.height}
            data-caption={p.caption ?? ''}
            data-date={p.date ?? ''}
            data-chips={p.chips.join('|')}
            aria-label={p.caption ? `Open photo: ${p.caption}` : p.date ? `Open photo from ${p.date}` : 'Open photo'}
          >
            <Image
              src={p.image}
              alt={p.caption ?? ''}
              widths={[400, 800, 1200]}
              sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 300px"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          </button>
        ))
      }
    </div>
  </div>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" data-lightbox inert>
    <div class="frost" data-frost></div>
    <img class="lb-img" data-lb-img src="data:," alt="" />
    <button class="btn square lb-close" type="button" aria-label="Close" data-lb-close>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
    <div class="lb-bar" data-lb-bar>
      <div class="lb-info">
        <p class="lb-title"><span data-lb-caption></span><span class="faint" data-lb-date></span></p>
        <p class="lb-chips" data-lb-chips></p>
      </div>
      <div class="lb-nav">
        <button class="btn square" type="button" aria-label="Previous photo" data-lb-prev>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M13 8H3.5M7.5 4l-4 4 4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <span class="lb-count mono num" data-lb-counter></span>
        <button class="btn square" type="button" aria-label="Next photo" data-lb-next>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M3 8h9.5M8.5 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!

  // A fresh order on every visit.
  const shuffled = Array.from(grid.children) as HTMLElement[]
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))
    ;[shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]]
  }
  grid.append(...shuffled)

  // Each photo fades in as it arrives.
  for (const img of grid.querySelectorAll('img')) {
    if (img.complete) img.dataset.loaded = ''
    else img.addEventListener('load', () => (img.dataset.loaded = ''), { once: true })
  }

  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]')!
  const frost = lightbox.querySelector<HTMLElement>('[data-frost]')!
  const lbImg = lightbox.querySelector<HTMLImageElement>('[data-lb-img]')!
  const bar = lightbox.querySelector<HTMLElement>('[data-lb-bar]')!
  const counter = lightbox.querySelector<HTMLElement>('[data-lb-counter]')!
  const captionEl = lightbox.querySelector<HTMLElement>('[data-lb-caption]')!
  const dateEl = lightbox.querySelector<HTMLElement>('[data-lb-date]')!
  const chipsEl = lightbox.querySelector<HTMLElement>('[data-lb-chips]')!
  const closeBtn = lightbox.querySelector<HTMLButtonElement>('[data-lb-close]')!
  const thumbs = Array.from(grid.querySelectorAll<HTMLElement>('.thumb'))

  // The viewer sits outside the page, so the page can be made inert beneath it.
  document.body.append(lightbox)
  const setPageInert = (inert: boolean) => {
    for (const el of document.body.children) {
      if (el !== lightbox && el.tagName !== 'SCRIPT') (el as HTMLElement).inert = inert
    }
  }

  // Warm up the backdrop blur so the first open isn't a cold start.
  requestAnimationFrame(() => {
    lightbox.dataset.visible = ''
    frost.style.transition = 'none'
    frost.style.opacity = '0.001'
    frost.getBoundingClientRect()
    requestAnimationFrame(() => {
      frost.style.opacity = ''
      delete lightbox.dataset.visible
      requestAnimationFrame(() => (frost.style.transition = ''))
    })
  })

  let currentIndex = -1
  let isOpen = false
  let returnFocus: HTMLElement | null = null
  let dragStartY = 0
  let dragY = 0
  let isDragging = false
  let pendingTimeouts: number[] = []

  function cancelPending() {
    pendingTimeouts.forEach((id) => clearTimeout(id))
    pendingTimeouts = []
  }

  type Rect = { left: number; top: number; width: number; height: number }

  // Centered above the info bar, as large as the photo allows.
  function getFinalRect(thumb: HTMLElement): Rect {
    const room = innerWidth < 640 ? 176 : 152
    const vw = innerWidth * 0.92
    const vh = innerHeight - room
    const w0 = Number(thumb.dataset.w) || 1080
    const h0 = Number(thumb.dataset.h) || 810
    const scale = Math.min(vw / w0, vh / h0, 1.5)
    const width = w0 * scale
    const height = h0 * scale
    return { left: (innerWidth - width) / 2, top: Math.max(16, (innerHeight - room - height) / 2 + 16), width, height }
  }

  function setFinalRect(rect: Rect) {
    lbImg.style.left = `${rect.left}px`
    lbImg.style.top = `${rect.top}px`
    lbImg.style.width = `${rect.width}px`
    lbImg.style.height = `${rect.height}px`
  }

  function getCurrentFinalRect(): Rect {
    return {
      left: parseFloat(lbImg.style.left),
      top: parseFloat(lbImg.style.top),
      width: parseFloat(lbImg.style.width),
      height: parseFloat(lbImg.style.height),
    }
  }

  function inverseTransform(thumbRect: Rect, finalRect: Rect) {
    const dx = thumbRect.left - finalRect.left
    const dy = thumbRect.top - finalRect.top
    const sx = thumbRect.width / finalRect.width
    const sy = thumbRect.height / finalRect.height
    return `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`
  }

  // Start from the thumbnail the browser already has, then sharpen to the
  // large copy once it's downloaded.
  function show(thumb: HTMLElement) {
    const small = thumb.querySelector('img')
    lbImg.src = small?.currentSrc || small?.src || ''
    const full = thumb.dataset.full
    if (!full) return
    const hi = new Image()
    hi.decoding = 'async'
    hi.src = full
    hi.decode().then(
      () => {
        if (thumbs[currentIndex] === thumb) lbImg.src = full
      },
      () => {},
    )
  }

  function describe(index: number) {
    const t = thumbs[index]
    counter.textContent = `${index + 1} / ${thumbs.length}`
    captionEl.textContent = t.dataset.caption ?? ''
    dateEl.textContent = t.dataset.date ?? ''
    chipsEl.replaceChildren(
      ...(t.dataset.chips ? t.dataset.chips.split('|') : []).map((c) => {
        const chip = document.createElement('span')
        chip.className = 'chip mono'
        chip.textContent = c
        return chip
      }),
    )
    lbImg.alt = t.dataset.caption ?? ''
  }

  function open(index: number) {
    // Interrupt any close in progress, and put the grid back as it was.
    cancelPending()
    if (currentIndex >= 0 && currentIndex !== index) thumbs[currentIndex].classList.remove('is-active')
    lbImg.style.transition = ''

    currentIndex = index
    const thumb = thumbs[index]
    const thumbRect = thumb.querySelector('img')!.getBoundingClientRect()
    returnFocus = thumb
    thumb.classList.add('is-active')

    show(thumb)
    describe(index)
    lbImg.classList.remove('animating')

    // Place it at its final rect, then invert back onto the thumbnail (FLIP).
    const final = getFinalRect(thumb)
    setFinalRect(final)
    lbImg.style.transformOrigin = '0 0'
    lbImg.style.transform = inverseTransform(thumbRect, final)
    lbImg.style.borderRadius = '8px'
    lbImg.style.opacity = '1'
    lbImg.style.willChange = 'transform'

    lightbox.dataset.visible = ''
    lightbox.dataset.open = ''
    lightbox.inert = false
    setPageInert(true)
    isOpen = true
    document.body.style.overflow = 'hidden'

    lbImg.getBoundingClientRect()
    requestAnimationFrame(() => {
      lbImg.classList.add('animating')
      lbImg.style.transform = ''
      lbImg.style.borderRadius = '6px'
    })

    pendingTimeouts.push(
      window.setTimeout(() => {
        bar.dataset.shown = ''
        closeBtn.dataset.shown = ''
        lbImg.style.willChange = ''
      }, 420),
    )
    closeBtn.focus({ preventScroll: true })
  }

  function finishClose() {
    isOpen = false
    delete lightbox.dataset.open
    lightbox.inert = true
    setPageInert(false)
    document.body.style.overflow = ''
    delete bar.dataset.shown
    delete closeBtn.dataset.shown
    returnFocus?.focus({ preventScroll: true })
  }

  function close() {
    if (!isOpen) return
    cancelPending()
    // Hand the page back right away, not after the morph.
    finishClose()

    const thumb = thumbs[currentIndex]
    const closingIndex = currentIndex
    const thumbRect = thumb.querySelector('img')!.getBoundingClientRect()
    const final = getCurrentFinalRect()

    lbImg.style.willChange = 'transform'
    lbImg.style.transformOrigin = '0 0'
    lbImg.classList.add('animating')
    lbImg.style.transform = inverseTransform(thumbRect, final)
    lbImg.style.borderRadius = '8px'

    pendingTimeouts.push(
      window.setTimeout(() => {
        thumb.classList.remove('is-active')
        delete lightbox.dataset.visible
      }, 480),
    )
    pendingTimeouts.push(
      window.setTimeout(() => {
        if (currentIndex === closingIndex) currentIndex = -1
        lbImg.classList.remove('animating')
        lbImg.style.transform = ''
        lbImg.style.willChange = ''
      }, 750),
    )
  }

  function navigate(dir: number) {
    if (!isOpen) return
    cancelPending()
    const nextIndex = (currentIndex + dir + thumbs.length) % thumbs.length
    const prevThumb = thumbs[currentIndex]

    // A fade and a slight settle on the way out.
    lbImg.style.transformOrigin = '50% 50%'
    lbImg.style.willChange = 'transform, opacity'
    lbImg.classList.add('animating')
    lbImg.style.transform = `translateX(${dir * -12}px) scale(0.98)`
    lbImg.style.opacity = '0'

    pendingTimeouts.push(
      window.setTimeout(() => {
        prevThumb.classList.remove('is-active')
        currentIndex = nextIndex
        const nextThumb = thumbs[nextIndex]
        nextThumb.classList.add('is-active')
        returnFocus = nextThumb

        show(nextThumb)
        describe(nextIndex)
        lbImg.classList.remove('animating')

        setFinalRect(getFinalRect(nextThumb))
        lbImg.style.transform = `translateX(${dir * 12}px) scale(1.02)`
        lbImg.style.opacity = '0'

        lbImg.getBoundingClientRect()
        requestAnimationFrame(() => {
          lbImg.classList.add('animating')
          lbImg.style.transform = ''
          lbImg.style.opacity = '1'
        })

        pendingTimeouts.push(window.setTimeout(() => (lbImg.style.willChange = ''), 400))
      }, 180),
    )
  }

  // Drag up or down to dismiss.
  lbImg.addEventListener('pointerdown', (e) => {
    if (!isOpen) return
    isDragging = true
    dragStartY = e.clientY
    dragY = 0
    lbImg.classList.remove('animating')
    lbImg.style.transformOrigin = '50% 50%'
    lbImg.style.willChange = 'transform'
    lbImg.setPointerCapture(e.pointerId)
    lbImg.style.cursor = 'grabbing'
  })

  lbImg.addEventListener('pointermove', (e) => {
    if (!isDragging) return
    dragY = e.clientY - dragStartY
    const progress = Math.min(Math.abs(dragY) / 300, 1)
    lbImg.style.transform = `translateY(${dragY}px) scale(${1 - progress * 0.15})`
    frost.style.opacity = String(1 - progress * 0.6)
  })

  lbImg.addEventListener('pointerup', () => {
    if (!isDragging) return
    isDragging = false
    lbImg.style.cursor = ''

    if (Math.abs(dragY) > 120) {
      cancelPending()
      finishClose()
      const dismissedIndex = currentIndex

      lbImg.style.transition = 'transform 0.3s ease, opacity 0.3s ease'
      lbImg.style.transform = `translateY(${dragY > 0 ? 400 : -400}px) scale(0.8)`
      lbImg.style.opacity = '0'
      frost.style.transition = 'opacity 0.3s ease'
      frost.style.opacity = '0'
      pendingTimeouts.push(
        window.setTimeout(() => {
          delete lightbox.dataset.visible
          pendingTimeouts.push(
            window.setTimeout(() => {
              thumbs[dismissedIndex]?.classList.remove('is-active')
              if (currentIndex === dismissedIndex) currentIndex = -1
              lbImg.style.transform = ''
              lbImg.style.opacity = ''
              lbImg.style.transition = ''
              lbImg.style.willChange = ''
              frost.style.opacity = ''
              frost.style.transition = ''
              lbImg.classList.remove('animating')
            }, 300),
          )
        }, 100),
      )
    } else {
      // Not far enough: settle back.
      lbImg.style.transition = 'transform 0.4s cubic-bezier(0.32, 0.72, 0, 1)'
      lbImg.style.transform = ''
      frost.style.opacity = ''
      setTimeout(() => {
        lbImg.style.transition = ''
        lbImg.style.willChange = ''
      }, 400)
    }
  })

  thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => open(i)))
  frost.addEventListener('click', close)
  closeBtn.addEventListener('click', close)
  lightbox.querySelector('[data-lb-prev]')!.addEventListener('click', () => navigate(-1))
  lightbox.querySelector('[data-lb-next]')!.addEventListener('click', () => navigate(1))

  document.addEventListener('keydown', (e) => {
    if (!isOpen) return
    if (e.key === 'Escape') close()
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1)
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigate(-1)
  })
</script>

<style>
  .wide {
    max-width: calc(1200px + var(--gutter) * 2);
  }

  .grid {
    margin-top: 32px;
    columns: 4 260px;
    column-gap: 12px;
  }

  .thumb {
    display: block;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: var(--surface-2);
    cursor: zoom-in;
    break-inside: avoid;
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease),
      filter 0.3s;
  }

  .thumb:hover :global(img) {
    filter: brightness(1.04);
  }

  .thumb.is-active :global(img) {
    opacity: 0 !important;
  }

  /* Each photo fades up as it loads (without a script they simply appear). */
  @media (scripting: enabled) {
    .thumb :global(img:not([data-loaded])) {
      opacity: 0;
      transform: scale(1.015);
    }
  }

  /* The viewer ------------------------------------------------------------- */

  /* The viewer itself never fades: an ancestor with opacity (or will-change:
     opacity) would stop the frosted layer from blurring the page. The frost
     fades on its own instead, and the viewer only switches visibility. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
  }

  .lightbox[data-visible] {
    visibility: visible;
  }

  .lightbox[data-open] {
    pointer-events: auto;
  }

  .frost {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(28px) saturate(140%);
    -webkit-backdrop-filter: blur(28px) saturate(140%);
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox[data-open] .frost {
    opacity: 1;
  }

  .lb-img {
    position: absolute;
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 24px 64px rgb(0 0 0 / 0.22);
    transform-origin: 0 0;
    object-fit: cover;
    touch-action: none;
  }

  .lb-img:global(.animating) {
    transition:
      transform 0.5s cubic-bezier(0.32, 0.72, 0, 1),
      border-radius 0.4s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.25s ease;
  }

  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .lb-close[data-shown] {
    opacity: 1;
  }

  .lb-bar {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px 24px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.35s,
      transform 0.45s var(--ease);
  }

  .lb-bar[data-shown] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .lb-info {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .lb-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .lb-title .faint {
    font-size: 13px;
    font-weight: 400;
  }

  .lb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .lb-chips:empty {
    display: none;
  }

  .lb-chips :global(.chip) {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: 11.5px;
    white-space: nowrap;
  }

  .lb-nav {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
  }

  .lb-count {
    min-width: 56px;
    color: var(--ink-2);
    font-size: 12.5px;
    text-align: center;
  }

  @media (max-width: 639px) {
    .grid {
      columns: 2;
      column-gap: 8px;
    }

    .thumb {
      margin-bottom: 8px;
      border-radius: var(--radius-sm);
    }

    .lb-bar {
      flex-direction: column;
      align-items: stretch;
      padding: 16px;
    }

    .lb-nav {
      justify-content: space-between;
    }
  }
</style>
