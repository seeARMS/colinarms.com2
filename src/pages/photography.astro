---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import Footer from '@/components/Footer.astro'
import Navbar from '@/components/Navbar.astro'
import SubscribeDialog from '@/components/SubscribeDialog.astro'

const photoFiles = import.meta.glob('/public/photos/*.{jpg,jpeg,png,webp}', { eager: true })
const photos = Object.keys(photoFiles)
  .map((p) => p.replace('/public/photos/', '').replace(/\.[^.]+$/, ''))
  .sort()
---

<Layout title="Photography" description="Wildlife, landscape, and astrophotography by Colin Armstrong." image="/photos/yosemite.jpg">
  <Navbar />
  <SubscribeDialog />

  <div class="min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-16 sm:pt-24 sm:pb-24">

      <div class="columns-2 md:columns-3 lg:columns-4 gap-3 space-y-3">
        {photos.map((name) => {
          const delay = (Math.random() * 0.8).toFixed(2)
          return (
            <button
              class="photo-thumb block w-full break-inside-avoid cursor-zoom-in overflow-hidden rounded-lg opacity-[0.01] animate-fade-in"
              style={`animation-delay: ${delay}s`}
              data-src={`/photos/${name}.jpg`}
            >
              <img
                src={`/photos/${name}.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                class="w-full block"
              />
            </button>
          )
        })}
      </div>
    </div>
  </div>

  <Footer />

  <!-- Lightbox overlay -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 text-white/70 hover:text-white transition-colors"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img
      id="lightbox-img"
      class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg"
      src=""
      alt=""
    />
  </div>

  <script>
    const lightbox = document.getElementById('lightbox')!
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement
    const thumbs = document.querySelectorAll('.photo-thumb')
    let activeThumb: HTMLElement | null = null

    function openLightbox(thumb: HTMLElement) {
      const src = thumb.getAttribute('data-src')!
      const img = thumb.querySelector('img')!
      const rect = img.getBoundingClientRect()

      activeThumb = thumb

      lightboxImg.src = src
      lightboxImg.style.transition = 'none'
      lightboxImg.style.position = 'fixed'
      lightboxImg.style.left = rect.left + 'px'
      lightboxImg.style.top = rect.top + 'px'
      lightboxImg.style.width = rect.width + 'px'
      lightboxImg.style.height = rect.height + 'px'
      lightboxImg.style.maxWidth = 'none'
      lightboxImg.style.maxHeight = 'none'
      lightboxImg.style.borderRadius = '0.5rem'

      lightbox.classList.remove('hidden')
      lightbox.classList.add('flex')
      lightbox.style.opacity = '0'

      requestAnimationFrame(() => {
        lightbox.style.transition = 'opacity 0.3s ease'
        lightbox.style.opacity = '1'

        // Calculate final centered size — fill 95% of viewport
        const vw = window.innerWidth * 0.95
        const vh = window.innerHeight * 0.95
        const naturalW = img.naturalWidth || rect.width
        const naturalH = img.naturalHeight || rect.height
        const scale = Math.min(vw / naturalW, vh / naturalH)
        const finalW = naturalW * scale
        const finalH = naturalH * scale
        const finalLeft = (window.innerWidth - finalW) / 2
        const finalTop = (window.innerHeight - finalH) / 2

        lightboxImg.style.transition = 'all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1)'
        lightboxImg.style.left = finalLeft + 'px'
        lightboxImg.style.top = finalTop + 'px'
        lightboxImg.style.width = finalW + 'px'
        lightboxImg.style.height = finalH + 'px'
        lightboxImg.style.borderRadius = '0.5rem'
      })

      document.body.style.overflow = 'hidden'
    }

    function closeLightbox() {
      if (!activeThumb) return
      const img = activeThumb.querySelector('img')!
      const rect = img.getBoundingClientRect()

      lightbox.style.transition = 'opacity 0.3s ease 0.1s'
      lightbox.style.opacity = '0'

      lightboxImg.style.transition = 'all 0.35s cubic-bezier(0.25, 0.1, 0.25, 1)'
      lightboxImg.style.left = rect.left + 'px'
      lightboxImg.style.top = rect.top + 'px'
      lightboxImg.style.width = rect.width + 'px'
      lightboxImg.style.height = rect.height + 'px'

      setTimeout(() => {
        lightbox.classList.add('hidden')
        lightbox.classList.remove('flex')
        lightboxImg.style.position = ''
        lightboxImg.style.left = ''
        lightboxImg.style.top = ''
        lightboxImg.style.width = ''
        lightboxImg.style.height = ''
        lightboxImg.style.maxWidth = ''
        lightboxImg.style.maxHeight = ''
        lightboxImg.style.transition = ''
        lightbox.style.transition = ''
        lightbox.style.opacity = ''
        activeThumb = null
        document.body.style.overflow = ''
      }, 400)
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => openLightbox(thumb as HTMLElement))
    })

    document.getElementById('lightbox-close')!.addEventListener('click', closeLightbox)
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox()
    })
  </script>
</Layout>
