---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/PostList.astro'
import SubscribeForm from '@/components/SubscribeForm.astro'
import { getColinArticles } from '@/lib/getAllArticles'
import { year } from '@/lib/format'
import { person } from '@/data/profile'
import { blog, breadcrumbs } from '@/lib/schema'

const articles = await getColinArticles()
const since = articles.length ? year(articles[articles.length - 1].isoDate) : ''
---

<Layout
  title="Writing on startups, product & engineering"
  description="Essays by Colin Armstrong, founder of Paragraph, on startups, product, engineering, and the open web. Subscribe to get new posts by email."
  image="/og/writing.png"
  schema={[blog(articles), breadcrumbs([{ name: 'Writing', path: '/writing' }])]}
>
  <div class="container">
    <header class="page-head">
      <h1>Writing</h1>
      <p class="summary">
        Thoughts on startups, product, engineering, and whatever else is on my mind. If you'd like to follow along,
        drop your email below.
      </p>
      <div class="subscribe">
        <SubscribeForm size="lg" />
      </div>
    </header>

    {
      articles.length > 0 && (
        <section class="section" aria-labelledby="archive">
          <div class="section-head">
            <h2 id="archive">Archive</h2>
            <span class="meta">
              {articles.length} posts since {since}, also on{' '}
              <a class="link" href={person.blog} rel="noopener">
                Paragraph
              </a>
            </span>
          </div>
          <PostList posts={articles} byYear />
        </section>
      )
    }
  </div>
</Layout>

<style>
  .subscribe {
    max-width: 500px;
    margin-top: 32px;
  }
</style>
