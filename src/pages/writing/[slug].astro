---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import PageToc from '@/components/PageToc.astro'
import PostList from '@/components/PostList.astro'
import SubscribeForm from '@/components/SubscribeForm.astro'
import { getColinArticlesWithContent } from '@/lib/getAllArticles'
import { longDate, postDescription, readingTime } from '@/lib/format'
import { blogPosting, breadcrumbs } from '@/lib/schema'
import { person } from '@/data/profile'
import { highlight } from '@/lib/highlight'

export async function getStaticPaths() {
  const posts = await getColinArticlesWithContent()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      ...post,
      allPosts: posts
        .filter((p) => p.slug !== post.slug)
        .map(({ html: _, ...rest }) => ({ ...rest, link: `/writing/${rest.slug}` })),
    },
  }))
}

const { slug } = Astro.params
const { title, subtitle, html, isoDate, updatedIso, paragraphSlug, allPosts } = Astro.props
const minutes = html ? readingTime(html) : 0
const body = html ? await highlight(html) : ''
const path = `/writing/${slug}`
const image = `/og/${slug}.png`
const description = postDescription(title, subtitle, html ?? '')
const words = html ? html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length : undefined
const schema = [
  blogPosting({ path, title, description, image, published: isoDate, modified: updatedIso, words }),
  breadcrumbs([
    { name: 'Writing', path: '/writing' },
    { name: title, path },
  ]),
]
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedDate={isoDate}
  modifiedDate={updatedIso}
  schema={schema}
  noindex={!html}
>
  <article class="post">
    <header class="page-head">
      <a class="back" href="/writing">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M13 8H3.5M7.5 4l-4 4 4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Writing
      </a>
      <p class="meta mono">
        <time datetime={isoDate}>{longDate(isoDate)}</time>
        {minutes > 0 && <span>{minutes} min read</span>}
      </p>
      <h1 data-vt-post={`/writing/${slug}`}>{title}</h1>
      {subtitle && <p class="summary">{subtitle}</p>}
    </header>

    {
      html ? (
        <div class="prose body" set:html={body} />
      ) : (
        <p class="empty">
          This post lives on Paragraph.{' '}
          <a class="link" href={`${person.blog}/${paragraphSlug}`} rel="noopener">
            Read it there
          </a>
          .
        </p>
      )
    }
  </article>

  <PageToc />

  <aside class="after" aria-label="More">
    <section class="card follow">
      <h2>Subscribe</h2>
      <p class="muted">Get new posts delivered to your inbox.</p>
      <SubscribeForm />
    </section>

    {
      allPosts.length > 0 && (
        <section class="more-posts" aria-labelledby="keep-reading">
          <div class="section-head">
            <h2 id="keep-reading">Keep reading</h2>
          </div>
          <PostList posts={allPosts} />
        </section>
      )
    }
  </aside>
</Layout>

<style>
  .post,
  .after {
    width: 100%;
    max-width: calc(var(--post) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    color: var(--ink-2);
    font-size: 13px;
    transition: color 120ms;
  }

  .back svg {
    width: 14px;
    height: 14px;
    transition: transform 160ms var(--ease);
  }

  .back:hover {
    color: var(--ink);
  }

  .back:hover svg {
    transform: translateX(-2px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-bottom: 10px;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .meta span::before {
    content: '·';
    margin-right: 14px;
  }

  .page-head h1 {
    width: fit-content;
    font-size: 38px;
  }

  .page-head .summary {
    font-size: 18px;
  }

  .body {
    margin-top: 40px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }

  .empty {
    margin-top: 40px;
    padding: 20px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-2);
  }

  .after {
    display: grid;
    gap: 48px;
    margin-top: 72px;
  }

  .follow {
    padding: 20px;
  }

  .follow h2 {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .follow p {
    margin: 2px 0 14px;
  }

  @media (max-width: 639px) {
    .page-head h1 {
      font-size: 30px;
    }

    .page-head .summary {
      font-size: 16px;
    }

    .body {
      margin-top: 28px;
      padding-top: 28px;
    }
  }
</style>
