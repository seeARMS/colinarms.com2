---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import Footer from '@/components/Footer.astro'
import { Image } from 'astro:assets'
import avatarImg from '../../../public/colin_v1.jpg'
import { getColinArticlesWithContent } from '@/lib/getAllArticles'

export async function getStaticPaths() {
  const posts = await getColinArticlesWithContent()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      ...post,
      allPosts: posts
        .filter((p) => p.slug !== post.slug)
        .map(({ html: _, ...rest }) => rest),
    },
  }))
}

const { title, subtitle, html, isoDate, allPosts } = Astro.props
const date = new Date(isoDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})
---

<Layout title={title}>
  <div
    id="sticky-nav"
    class="fixed top-0 left-0 right-0 z-50 translate-y-[-100%] opacity-0 transition-all duration-300 ease-out border-b border-zinc-200 dark:border-zinc-700 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm"
  >
    <div class="relative px-4 sm:px-6 py-3 flex items-center">
      <nav class="flex items-center gap-2 text-sm text-zinc-400 dark:text-zinc-500 shrink-0">
        <a href="/" class="flex items-center gap-2 hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors duration-200">
          <Image
            src={avatarImg}
            alt="Colin Armstrong"
            width={24}
            height={24}
            format="webp"
            quality={80}
            class="rounded-full"
          />
          <span>Colin Armstrong</span>
        </a>
        <span>/</span>
        <a href="/writing" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors duration-200">Writing</a>
      </nav>
      <span class="absolute left-1/2 -translate-x-1/2 text-sm font-medium text-zinc-900 dark:text-zinc-100 truncate max-w-[50%] text-center pointer-events-none">
        {title}
      </span>
      <button
        id="subscribe-btn"
        class="ml-auto shrink-0 text-sm font-medium px-4 py-1.5 rounded-full bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200"
      >
        Subscribe
      </button>
    </div>
  </div>

  <article class="min-h-screen">
    <div class="max-w-2xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
      <nav class="flex items-center gap-2 text-sm text-zinc-400 dark:text-zinc-500">
        <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors duration-200">Home</a>
        <span>/</span>
        <a href="/writing" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors duration-200">Writing</a>
      </nav>

      <header id="post-header" class="mt-8 mb-8">
        <time class="text-sm text-zinc-500">{date}</time>
        <h1
          class="mt-2 text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100 leading-tight"
        >
          {title}
        </h1>
        {subtitle && (
          <p class="mt-3 text-lg text-zinc-500 dark:text-zinc-400">
            {subtitle}
          </p>
        )}
      </header>

      <div
        class="prose prose-lg prose-zinc dark:prose-invert prose-a:text-blue-600 prose-a:no-underline hover:prose-a:text-blue-400 dark:prose-a:text-blue-400 dark:hover:prose-a:text-blue-300 max-w-none [&>h2:first-child]:mt-0 [&>h3:first-child]:mt-0"
        set:html={html}
      />
    </div>
  </article>

  <div class="max-w-2xl mx-auto px-6 sm:px-8 py-12 space-y-6">
    <!-- Subscribe well -->
    <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Subscribe</h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">Get new posts delivered to your inbox.</p>
      <form class="subscribe-form flex gap-2">
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 min-w-0 px-3 py-2 text-sm rounded-lg border border-zinc-200 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button
          type="submit"
          class="shrink-0 px-5 py-2 text-sm font-medium rounded-lg bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200 disabled:opacity-50"
        >
          Subscribe
        </button>
      </form>
      <p class="subscribe-msg text-sm mt-3 hidden"></p>
    </div>

    <!-- Related posts well -->
    {allPosts.length > 0 && (
      <div class="bg-gray-50 dark:bg-zinc-800 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-4">Related posts</h3>
        <div class="flex gap-4 overflow-x-auto pb-2 -mx-2 px-2 snap-x snap-mandatory scrollbar-hide">
          {allPosts.map((post) => {
            const date = new Date(post.isoDate).toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            })
            return (
              <a
                href={`/writing/${post.slug}`}
                class="group shrink-0 w-64 snap-start bg-white dark:bg-zinc-900 rounded-xl p-5 border border-zinc-200 dark:border-zinc-700 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors duration-200"
              >
                <time class="text-xs text-zinc-400 dark:text-zinc-500">{date}</time>
                <h4 class="mt-1.5 text-sm font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200 line-clamp-2">
                  {post.title}
                </h4>
                {post.subtitle && (
                  <p class="mt-1.5 text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">
                    {post.subtitle}
                  </p>
                )}
              </a>
            )
          })}
        </div>
      </div>
    )}
  </div>

  <Footer />

  <dialog
    id="subscribe-dialog"
    class="fixed inset-0 m-auto backdrop:bg-black/50 backdrop:backdrop-blur-sm bg-white dark:bg-zinc-900 rounded-lg shadow-xl p-0 w-full max-w-sm border border-zinc-200 dark:border-zinc-700"
  >
    <div class="p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Subscribe</h2>
        <button id="close-dialog" class="text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">Get new posts delivered to your inbox.</p>
      <form id="subscribe-form" class="flex gap-2">
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 min-w-0 px-3 py-2 text-sm rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button
          type="submit"
          class="shrink-0 px-4 py-2 text-sm font-medium rounded-lg bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300 transition-colors duration-200 disabled:opacity-50"
        >
          Subscribe
        </button>
      </form>
      <p id="subscribe-msg" class="text-sm mt-3 hidden"></p>
    </div>
  </dialog>

  <script>
    const nav = document.getElementById('sticky-nav')!
    const header = document.getElementById('post-header')!
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          nav.classList.add('translate-y-[-100%]', 'opacity-0')
          nav.classList.remove('translate-y-0', 'opacity-100')
        } else {
          nav.classList.remove('translate-y-[-100%]', 'opacity-0')
          nav.classList.add('translate-y-0', 'opacity-100')
        }
      },
      { threshold: 0 },
    )
    observer.observe(header)

    const dialog = document.getElementById('subscribe-dialog') as HTMLDialogElement
    const form = document.getElementById('subscribe-form') as HTMLFormElement
    const msg = document.getElementById('subscribe-msg')!

    document.getElementById('subscribe-btn')!.addEventListener('click', () => {
      dialog.showModal()
      dialog.classList.remove('animate-dialog-in')
      void dialog.offsetWidth
      dialog.classList.add('animate-dialog-in')
    })
    document.getElementById('close-dialog')!.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    })

    async function handleSubscribe(f: HTMLFormElement, msgEl: HTMLElement) {
      const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement
      const email = new FormData(f).get('email') as string

      btn.disabled = true
      msgEl.classList.add('hidden')

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        })
        const data = await res.json()
        if (res.ok) {
          msgEl.textContent = 'Subscribed!'
          msgEl.className = 'text-sm mt-3 text-green-600 dark:text-green-400'
          f.reset()
        } else {
          msgEl.textContent = data.error || 'Something went wrong.'
          msgEl.className = 'text-sm mt-3 text-red-600 dark:text-red-400'
        }
      } catch {
        msgEl.textContent = 'Something went wrong.'
        msgEl.className = 'text-sm mt-3 text-red-600 dark:text-red-400'
      } finally {
        btn.disabled = false
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      handleSubscribe(form, msg)
    })

    document.querySelectorAll('.subscribe-form').forEach((f) => {
      const formEl = f as HTMLFormElement
      const msgEl = formEl.nextElementSibling as HTMLElement
      formEl.addEventListener('submit', (e) => {
        e.preventDefault()
        handleSubscribe(formEl, msgEl)
      })
    })
  </script>
</Layout>
