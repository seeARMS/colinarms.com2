---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import PageToc from '@/components/PageToc.astro'
import PostList from '@/components/PostList.astro'
import SubscribeForm from '@/components/SubscribeForm.astro'
import { getColinArticlesWithContent } from '@/lib/getAllArticles'
import { longDate, postDescription, readingTime } from '@/lib/format'
import { blogPosting, breadcrumbs } from '@/lib/schema'
import { highlight } from '@/lib/highlight'
import { optimizeImages } from '@/lib/post-images'

export async function getStaticPaths() {
  const posts = await getColinArticlesWithContent()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      ...post,
      allPosts: posts
        .filter((p) => p.slug !== post.slug && !p.unlisted)
        .map(({ html: _, markdown: __, unlisted: ___, ...rest }) => ({ ...rest, link: `/writing/${rest.slug}` })),
    },
  }))
}

const { slug } = Astro.params
const { title, subtitle, html, isoDate, updatedIso, allPosts } = Astro.props
const minutes = html ? readingTime(html) : 0
const body = html ? await optimizeImages(await highlight(html)) : ''
const path = `/writing/${slug}`
const image = `/og/${slug}.jpg`
const description = postDescription(title, subtitle, html ?? '')
const words = html ? html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length : undefined
const schema = [
  blogPosting({ path, title, description, image, published: isoDate, modified: updatedIso, words }),
  breadcrumbs([
    { name: 'Writing', path: '/writing' },
    { name: title, path },
  ]),
]
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedDate={isoDate}
  modifiedDate={updatedIso}
  schema={schema}
  noindex={!html}
>
  <article class="post">
    <header class="page-head">
      <a class="back" href="/writing">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M13 8H3.5M7.5 4l-4 4 4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Writing
      </a>
      <h1 data-vt-post={`/writing/${slug}`}>{title}</h1>
      {subtitle && <p class="summary">{subtitle}</p>}
      <p class="meta">
        <time datetime={isoDate}>{longDate(isoDate)}</time>
        {minutes > 0 && <span>{minutes} minute read</span>}
      </p>
    </header>

    {
      html ? (
        <div class="prose body" set:html={body} />
      ) : (
        <p class="empty">This post's text couldn't be loaded when the site was built.</p>
      )
    }
  </article>

  <PageToc />

  <aside class="after" aria-label="More">
    <section class="follow" aria-labelledby="subscribe">
      <h2 id="subscribe">Subscribe</h2>
      <p class="muted">Get new posts delivered to your inbox.</p>
      <SubscribeForm />
    </section>

    {
      allPosts.length > 0 && (
        <section class="more-posts" aria-labelledby="keep-reading">
          <div class="section-head">
            <h2 id="keep-reading">Keep reading</h2>
          </div>
          <PostList posts={allPosts} />
        </section>
      )
    }
  </aside>
</Layout>

<script>
  // Once a post image has arrived, drop its blurred preview, so the preview
  // can't show through the transparent parts of a screenshot.
  for (const img of document.querySelectorAll<HTMLImageElement>('.prose img[data-blur]')) {
    const arrived = () => {
      img.style.removeProperty('background-image')
      delete img.dataset.blur
    }
    if (img.complete && img.naturalWidth) arrived()
    else img.addEventListener('load', arrived, { once: true })
  }
</script>

<style>
  .post,
  .after {
    width: 100%;
    max-width: calc(var(--post) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .back svg {
    width: 15px;
    height: 15px;
    transition: transform 220ms var(--ease);
  }

  .back:hover {
    color: var(--blue);
  }

  .back:hover svg {
    transform: translateX(-3px);
  }

  .page-head h1 {
    width: fit-content;
    font-size: 48px;
    line-height: 1.08;
  }

  .page-head .summary {
    margin-top: 16px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 20px;
    color: var(--ink-3);
    font-size: 16px;
  }

  .body {
    margin-top: 44px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .empty {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .after {
    display: grid;
    /* Never wider than the column: an auto track would grow to the subscribe
       field's natural width and push the page sideways on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 72px;
    margin-top: 88px;
  }

  .follow {
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .follow h2 {
    font-size: 30px;
    font-weight: 380;
    letter-spacing: -0.015em;
  }

  .follow p {
    margin: 6px 0 20px;
    font-size: 18px;
  }

  .follow :global(.subscribe) {
    max-width: 500px;
  }

  @media (max-width: 639px) {
    .page-head h1 {
      font-size: 36px;
    }

    .body {
      margin-top: 32px;
      padding-top: 30px;
    }
  }
</style>
