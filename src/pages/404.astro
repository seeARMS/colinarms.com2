---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import { getColinArticles } from '@/lib/getAllArticles'

// A wrong address, marked up the way an editor would: struck through with a
// pen, and the right one written in beneath it when there's a likely match.
const pages = [
  { path: '/', title: 'Home' },
  { path: '/writing', title: 'Writing' },
  { path: '/projects', title: 'Projects & Work' },
  { path: '/photography', title: 'Photography' },
  { path: '/contact', title: 'Contact' },
]

// Everything a mistyped or old link might have meant.
const articles = await getColinArticles({ includeUnlisted: true })
const routes = [...pages, ...articles.map((a) => ({ path: a.link, title: a.title }))]
---

<Layout title="Page not found" description="There's nothing at this address." noindex>
  <div class="container">
    <header class="page-head">
      <h1>Page not found</h1>
    </header>

    <div class="markup">
      <p class="wrong">
        <span class="struck">armstr.ng<span data-path>/</span></span>
      </p>
      <p class="correction" data-suggest hidden>
        Did you mean <a class="link" href="/" data-suggest-link></a>?
      </p>
    </div>

    <p class="summary">There's no page at this address. It may have moved, or the link has a typo.</p>

    <section class="section" aria-labelledby="elsewhere">
      <div class="section-head">
        <h2 id="elsewhere">Where to go instead</h2>
      </div>
      <ul class="rows">
        {
          pages.map((p) => (
            <li>
              <a class="go" href={p.path}>
                <span class="stroke">{p.title}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M3 8h9.5M8.5 4l4 4-4 4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <script type="application/json" id="routes" set:html={JSON.stringify(routes)} />
</Layout>

<script>
  type Route = { path: string; title: string }

  // A malformed address (a stray %) shouldn't break the page that explains it.
  const decode = (p: string) => {
    try {
      return decodeURIComponent(p)
    } catch {
      return p
    }
  }

  const here = decode(location.pathname)
  for (const slot of document.querySelectorAll('[data-path]')) slot.textContent = here

  // Did you mean: the closest real page, judged mostly by the last part of the
  // path, so old links like /posts/data-spectrum still find their post.
  const routes: Route[] = JSON.parse(document.getElementById('routes')?.textContent ?? '[]')
  const norm = (p: string) =>
    decode(p)
      .toLowerCase()
      .replace(/\.html$/, '')
      .replace(/\/+$/, '') || '/'
  const last = (p: string) => p.split('/').filter(Boolean).pop() ?? ''

  function distance(a: string, b: string) {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i)
    for (let i = 1; i <= a.length; i++) {
      let prev = row[0]
      row[0] = i
      for (let j = 1; j <= b.length; j++) {
        const next = row[j]
        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1))
        prev = next
      }
    }
    return row[b.length]
  }
  const likeness = (a: string, b: string) => (a || b ? 1 - distance(a, b) / Math.max(a.length, b.length) : 1)

  const wanted = norm(here)
  let best: Route | undefined
  let score = 0
  for (const r of routes) {
    if (r.path === '/') continue
    const target = norm(r.path)
    const s = Math.max(likeness(last(wanted), last(target)), likeness(wanted, target))
    if (s > score) {
      score = s
      best = r
    }
  }
  const suggest = document.querySelector<HTMLElement>('[data-suggest]')
  const link = suggest?.querySelector<HTMLAnchorElement>('[data-suggest-link]')
  if (suggest && link && best && score >= 0.6 && norm(best.path) !== wanted) {
    link.href = best.path
    link.textContent = best.title
    suggest.hidden = false
  }
</script>

<style>
  .markup {
    margin-top: 40px;
  }

  .wrong {
    color: var(--ink-2);
    font-size: 30px;
    font-weight: 360;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  /* The pen stroke through the address, drawn left to right. */
  .struck {
    background: linear-gradient(var(--blue), var(--blue)) no-repeat left 58% / 100% 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .correction {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 21px;
    font-style: italic;
  }

  .correction a {
    color: var(--blue);
  }

  .summary {
    margin-top: 32px;
  }

  .go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    font-size: 19px;
  }

  .go svg {
    width: 15px;
    height: 15px;
    color: var(--ink-3);
    transition: transform 220ms var(--ease);
  }

  .go:hover svg {
    color: var(--blue);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .struck {
      animation: strike 0.7s var(--ease) 0.35s both;
    }

    .correction {
      animation: fade 0.6s ease-out 1s both;
    }
  }

  @keyframes strike {
    from {
      background-size: 0 2px;
    }
  }

  @media (max-width: 639px) {
    .markup {
      margin-top: 28px;
    }

    .wrong {
      font-size: 24px;
    }

    .correction {
      font-size: 19px;
    }
  }
</style>
