---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import { getColinArticles } from '@/lib/getAllArticles'

// A route that stops short, in heade.rs's dead-end language: a dot field, you
// on the left, armstr.ng answering in the middle, and a hole where the page
// should be. Coordinates are in the drawing's own 640×200 space.
const W = 640
const H = 200
const GAP = 14
const YOU = { x: 92, y: 132 }
const SITE = { x: 318, y: 86 }
const HOLE = { x: 548, y: 104, r: 22 }

let field = ''
for (let y = GAP / 2; y < H; y += GAP) {
  for (let x = GAP / 2; x < W; x += GAP) {
    if (Math.hypot(x - HOLE.x, y - HOLE.y) < HOLE.r + 9) continue
    field += `M${x} ${y}h0`
  }
}

// Each hop bows upward, like the arcs on heade.rs's maps.
function arc(a: { x: number; y: number }, b: { x: number; y: number }) {
  const dx = b.x - a.x
  const dy = b.y - a.y
  const len = Math.hypot(dx, dy)
  const cx = (a.x + b.x) / 2 + (dy / len) * len * 0.3
  const cy = (a.y + b.y) / 2 - (Math.abs(dx) / len) * len * 0.3
  return `M${a.x} ${a.y}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x} ${b.y}`
}

const at = (p: { x: number; y: number }) => `--x:${((p.x / W) * 100).toFixed(3)}%;--y:${((p.y / H) * 100).toFixed(3)}%`

// Everything a mistyped or old link might have meant.
const articles = await getColinArticles()
const routes = [
  { path: '/', title: 'Home' },
  { path: '/projects', title: 'Projects & Work' },
  { path: '/writing', title: 'Writing' },
  { path: '/photography', title: 'Photography' },
  { path: '/contact', title: 'Contact' },
  ...articles.map((a) => ({ path: a.link, title: a.title })),
]
---

<Layout title="Page not found" description="There's nothing at this address." noindex>
  <div class="container lost">
    <figure class="route" data-route aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
        <path class="field" d={field}></path>
        <g class="hops">
          <path class="hop reached" d={arc(YOU, SITE)} data-hop1></path>
          <path class="hop missing" d={arc(SITE, HOLE)} data-hop2></path>
        </g>
        <g class="hole" data-hole>
          <circle class="ring" cx={HOLE.x} cy={HOLE.y} r={HOLE.r}></circle>
          <circle class="lost-ring" cx={HOLE.x} cy={HOLE.y} r={HOLE.r}></circle>
          <text x={HOLE.x} y={HOLE.y + 5.5} text-anchor="middle">?</text>
        </g>
        <g class="node you">
          <circle class="halo" cx={YOU.x} cy={YOU.y} r="5"></circle>
          <circle class="dot" cx={YOU.x} cy={YOU.y} r="5"></circle>
        </g>
        <g class="node site" data-site>
          <circle class="arrive" cx={SITE.x} cy={SITE.y} r="5"></circle>
          <circle class="dot" cx={SITE.x} cy={SITE.y} r="5"></circle>
        </g>
        <g class="packet" data-packet transform={`translate(${YOU.x} ${YOU.y})`}>
          <circle class="packet-halo" r="11"></circle>
          <circle class="packet-dot" r="4.5"></circle>
        </g>
      </svg>

      <span class="label you-label" style={at(YOU)}><b>You</b></span>
      <span class="label site-label" style={at(SITE)}>
        <b>armstr.ng</b>
        <span class="sub mono" data-rtt>Reached</span>
      </span>
      <span class="label hole-label" style={at({ x: HOLE.x, y: HOLE.y + HOLE.r })}>
        <span class="mono path" data-path>/</span>
        <span class="badge red mono">404</span>
      </span>
    </figure>

    <p class="kicker mono">404 Not Found</p>
    <h1>No route to this page</h1>
    <p class="summary">
      <span class="mono where">armstr.ng<span data-path>/</span></span> doesn't exist. It may have moved, or the link has a
      typo.
    </p>

    <a class="card suggest" href="/" data-suggest hidden>
      <span class="faint">Did you mean</span>
      <span class="suggest-title" data-suggest-title></span>
      <span class="mono suggest-path" data-suggest-path></span>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M3 8h9.5M8.5 4l4 4-4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>

    <p class="actions">
      <a class="btn primary" href="/">Go home</a>
    </p>
    <p class="try">
      <span class="faint">Try</span>
      {
        routes.slice(1, 5).map((r) => (
          <a class="mono" href={r.path}>
            {r.path}
          </a>
        ))
      }
    </p>

    <details class="headers" data-headers hidden>
      <summary>
        <svg class="caret" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="m6 3.5 4.5 4.5L6 12.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Response headers
      </summary>
      <dl class="card rows" data-header-rows></dl>
    </details>
  </div>

  <script type="application/json" id="routes" set:html={JSON.stringify(routes)} />
</Layout>

<script>
  type Route = { path: string; title: string }

  // A malformed address (a stray %) shouldn't break the page that explains it.
  const decode = (p: string) => {
    try {
      return decodeURIComponent(p)
    } catch {
      return p
    }
  }

  const here = decode(location.pathname)
  for (const slot of document.querySelectorAll('[data-path]')) slot.textContent = here

  // Did you mean: the closest real page, judged mostly by the last part of the
  // path, so old links like /posts/data-spectrum still find their post.
  const routes: Route[] = JSON.parse(document.getElementById('routes')?.textContent ?? '[]')
  const norm = (p: string) =>
    decode(p)
      .toLowerCase()
      .replace(/\.html$/, '')
      .replace(/\/+$/, '') || '/'
  const last = (p: string) => p.split('/').filter(Boolean).pop() ?? ''

  function distance(a: string, b: string) {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i)
    for (let i = 1; i <= a.length; i++) {
      let prev = row[0]
      row[0] = i
      for (let j = 1; j <= b.length; j++) {
        const next = row[j]
        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1))
        prev = next
      }
    }
    return row[b.length]
  }
  const likeness = (a: string, b: string) => (a || b ? 1 - distance(a, b) / Math.max(a.length, b.length) : 1)

  const wanted = norm(here)
  let best: Route | undefined
  let score = 0
  for (const r of routes) {
    if (r.path === '/') continue
    const target = norm(r.path)
    const s = Math.max(likeness(last(wanted), last(target)), likeness(wanted, target))
    if (s > score) {
      score = s
      best = r
    }
  }
  const suggest = document.querySelector<HTMLAnchorElement>('[data-suggest]')
  if (suggest && best && score >= 0.6 && norm(best.path) !== wanted) {
    suggest.href = best.path
    suggest.querySelector('[data-suggest-title]')!.textContent = best.title
    suggest.querySelector('[data-suggest-path]')!.textContent = decode(best.path)
    suggest.hidden = false
  }

  // Ask for this address again, and show what came back: how long it took,
  // which data center answered, and the headers.
  const route = document.querySelector<HTMLElement>('[data-route]')!
  const rttSlot = route.querySelector('[data-rtt]')!
  const headers = document.querySelector<HTMLDetailsElement>('[data-headers]')!
  const rows = headers.querySelector('[data-header-rows]')!
  let travel = 1150

  const row = (name: string, value: string, tone?: string) => {
    const wrap = document.createElement('div')
    wrap.className = 'row'
    const dt = document.createElement('dt')
    dt.className = 'mono'
    dt.textContent = name
    const dd = document.createElement('dd')
    dd.className = tone ? `mono ${tone}` : 'mono'
    dd.textContent = value
    wrap.append(dt, dd)
    return wrap
  }

  ;(async () => {
    try {
      const t0 = performance.now()
      const res = await fetch(location.href, { method: 'HEAD', cache: 'no-store' })
      const ms = Math.round(performance.now() - t0)
      const colo = res.headers.get('cf-ray')?.split('-')[1]
      rttSlot.textContent = colo ? `${ms} ms · ${colo}` : `${ms} ms`
      // The packet flies at a speed set by the real round trip.
      travel = Math.min(1900, Math.max(750, 650 + ms * 6))

      // HTTP/2 carries no reason phrase (and some servers send the wrong one),
      // so name the usual ones ourselves.
      const reason = ({ 200: 'OK', 404: 'Not Found', 410: 'Gone' } as Record<number, string>)[res.status] ?? res.statusText
      rows.append(
        row('status', `${res.status} ${reason}`.trim(), res.ok ? undefined : 'bad'),
        row('time', `${ms} ms`),
        ...[...res.headers].sort(([a], [b]) => a.localeCompare(b)).map(([name, value]) => row(name, value)),
      )
      headers.hidden = false
    } catch {
      // Offline or blocked: the page still says everything it needs to.
    }
  })()

  // The packet: out to armstr.ng, a pause while it answers, then on toward the
  // page, fading before it gets there. It rests, then tries again.
  const hop1 = route.querySelector<SVGPathElement>('[data-hop1]')!
  const hop2 = route.querySelector<SVGPathElement>('[data-hop2]')!
  const packet = route.querySelector<SVGGElement>('[data-packet]')!
  const site = route.querySelector<SVGGElement>('[data-site]')!
  const hole = route.querySelector<SVGGElement>('[data-hole]')!
  const calm = matchMedia('(prefers-reduced-motion: reduce)')
  const L1 = hop1.getTotalLength()
  const L2 = hop2.getTotalLength()
  const PAUSE = 280
  const ONWARD = 1500
  const REST = 1600
  const SHORT = 0.8

  const inOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2)
  const out = (t: number) => 1 - (1 - t) ** 3
  const ping = (el: Element) => {
    el.classList.remove('ping')
    void (el as SVGGElement).getBBox()
    el.classList.add('ping')
  }

  let start = performance.now() + 1500 // after the drawing has come in
  let phase = -1
  let raf = 0

  function frame(now: number) {
    let t = now - start
    if (t >= 0) {
      t %= travel + PAUSE + ONWARD + REST
      let point: DOMPoint | undefined
      let opacity = 1
      let next: number
      if (t < travel) {
        next = 0
        point = hop1.getPointAtLength(inOut(t / travel) * L1)
      } else if (t < travel + PAUSE) {
        next = 1
        point = hop1.getPointAtLength(L1)
      } else if (t < travel + PAUSE + ONWARD) {
        next = 2
        const k = (t - travel - PAUSE) / ONWARD
        point = hop2.getPointAtLength(out(k) * L2 * SHORT)
        opacity = k < 0.5 ? 1 : 1 - (k - 0.5) / 0.5
      } else {
        next = 3
        opacity = 0
      }
      if (next !== phase) {
        if (next === 1) ping(site)
        if (next === 3) ping(hole)
        phase = next
      }
      if (point) packet.setAttribute('transform', `translate(${point.x.toFixed(1)} ${point.y.toFixed(1)})`)
      packet.style.opacity = String(opacity)
    }
    raf = requestAnimationFrame(frame)
  }

  const run = () => {
    cancelAnimationFrame(raf)
    if (!calm.matches && document.visibilityState === 'visible') raf = requestAnimationFrame(frame)
  }
  document.addEventListener('visibilitychange', run)
  calm.addEventListener('change', run)
  run()
</script>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: calc(680px + var(--gutter) * 2);
    padding-top: 40px;
    text-align: center;
  }

  /* The drawing ------------------------------------------------------------ */

  /* The drawing runs wider than the words beneath it. */
  .route {
    position: relative;
    flex: none;
    width: min(calc(100vw - var(--gutter) * 2), 880px);
    margin: 0 0 28px;
    aspect-ratio: 640 / 200;
  }

  .route svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .field {
    fill: none;
    stroke: var(--dot);
    stroke-width: 2.6px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    /* Fades toward the edges, like heade.rs's dead-end art. */
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 35%, transparent 100%);
    animation: fade 0.9s ease-out both;
  }

  .hop {
    fill: none;
    stroke-width: 1.5px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .reached {
    stroke: var(--blue);
    opacity: 0.45;
  }

  .missing {
    stroke: var(--ink-3);
    stroke-dasharray: 3 5;
    opacity: 0.7;
  }

  /* The route draws itself left to right. */
  .hops {
    animation: wipe 1.3s var(--ease) 0.2s both;
  }

  .ring {
    fill: var(--bg);
    stroke: var(--ink-3);
    stroke-width: 1.5px;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    animation: turn 18s linear infinite;
  }

  .hole text {
    fill: var(--ink-3);
    font: 600 16px var(--font-sans);
  }

  .hole {
    animation: pop 0.45s var(--ease) 1.05s both;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* When the packet gives out, a faint ring goes out from the hole. */
  .lost-ring {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5px;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hole:global(.ping) .lost-ring {
    animation: lost 1.1s cubic-bezier(0, 0, 0.2, 1);
  }

  .node {
    transform-box: fill-box;
    transform-origin: center;
  }

  .you {
    animation: pop 0.4s var(--ease) 0.15s both;
  }

  .site {
    animation: pop 0.4s var(--ease) 0.7s both;
  }

  .you .dot {
    fill: var(--ink);
    stroke: var(--bg);
    stroke-width: 2px;
  }

  .you .halo {
    fill: var(--ink);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 2.6s cubic-bezier(0, 0, 0.2, 1) 1.6s infinite;
  }

  .site .dot {
    fill: var(--blue);
    stroke: var(--bg);
    stroke-width: 2px;
  }

  .arrive {
    fill: var(--blue);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .site:global(.ping) .arrive {
    animation: arrive 0.9s cubic-bezier(0, 0, 0.2, 1);
  }

  .packet {
    opacity: 0;
  }

  .packet-dot {
    fill: var(--blue);
  }

  .packet-halo {
    fill: var(--blue);
    opacity: 0.18;
  }

  /* Node labels, as cards like heade.rs's map labels. */
  .label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 38%;
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.05);
    font-size: 12.5px;
    line-height: 1.3;
    white-space: nowrap;
    transform: translate(-50%, 14px);
    animation: rise-in 0.45s var(--ease) both;
  }

  .label b {
    font-weight: 600;
  }

  .you-label {
    animation-delay: 0.35s;
  }

  .site-label {
    animation-delay: 0.9s;
    flex-direction: column;
    gap: 1px;
  }

  .hole-label {
    animation-delay: 1.25s;
    transform: translate(-50%, 10px);
  }

  .sub {
    color: var(--ink-3);
    font-size: 11.5px;
  }

  .path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-2);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 -2% 0 0);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes breathe {
    from {
      opacity: 0.35;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0.5;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.6);
    }
  }

  @keyframes lost {
    from {
      opacity: 0.5;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  /* The words -------------------------------------------------------------- */

  h1 {
    margin-top: 6px;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .summary {
    max-width: 52ch;
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .where {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .suggest {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label arrow'
      'title arrow'
      'path arrow';
    align-items: center;
    gap: 2px 16px;
    width: min(100%, 460px);
    margin-top: 24px;
    padding: 14px 16px;
    text-align: left;
    transition: border-color 120ms;
    animation: rise-in 0.4s var(--ease) both;
  }

  .suggest[hidden] {
    display: none;
  }

  .suggest:hover {
    border-color: var(--line-strong);
  }

  .suggest .faint {
    grid-area: label;
    font-size: 12.5px;
  }

  .suggest-title {
    grid-area: title;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .suggest-path {
    grid-area: path;
    color: var(--ink-3);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggest svg {
    grid-area: arrow;
    width: 16px;
    height: 16px;
    color: var(--ink-3);
    transition:
      transform 160ms var(--ease),
      color 120ms;
  }

  .suggest:hover svg {
    color: var(--ink);
    transform: translateX(2px);
  }

  .actions {
    margin-top: 24px;
  }

  /* heade.rs's "Try" chips. */
  .try {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 13px;
  }

  .try a {
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 12.5px;
    transition:
      color 120ms,
      border-color 120ms;
  }

  .try a:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  /* What the server sent back, behind a disclosure. */
  .headers {
    width: 100%;
    margin-top: 40px;
    text-align: left;
  }

  .headers[hidden] {
    display: none;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0 auto;
    padding: 2px 6px;
    border-radius: 5px;
    color: var(--ink-2);
    font-size: 13px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .headers summary {
    display: flex;
    width: max-content;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--ink);
  }

  .caret {
    width: 14px;
    height: 14px;
    transition: transform 160ms ease;
  }

  .headers[open] .caret {
    transform: rotate(90deg);
  }

  .headers .rows {
    margin-top: 12px;
    font-size: 12.5px;
    animation: drop 0.18s ease-out;
  }

  .headers :global(.row) {
    align-items: baseline;
    min-height: 40px;
    padding: 9px 16px;
  }

  .headers :global(dt) {
    flex: none;
    color: var(--ink-2);
  }

  .headers :global(dd) {
    min-width: 0;
    margin: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .headers :global(dd.bad) {
    color: var(--red);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (max-width: 559px) {
    .lost {
      padding-top: 24px;
    }

    h1 {
      font-size: 30px;
    }

    .summary {
      font-size: 15px;
    }

    .label {
      padding: 3px 7px;
      font-size: 11.5px;
    }

    .sub {
      display: none;
    }

    .hole-label .badge {
      display: none;
    }

    /* Keep the path's label inside the drawing's right edge. */
    .hole-label {
      left: auto;
      right: 0;
      max-width: 46%;
      transform: translate(0, 10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field,
    .hops,
    .hole,
    .you,
    .site,
    .label,
    .ring,
    .you .halo,
    .suggest,
    .headers .rows {
      animation: none;
    }
  }
</style>
