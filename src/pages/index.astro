---
export const prerender = true

import { Image, getImage } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/PostList.astro'
import WorkTimeline from '@/components/WorkTimeline.astro'
import avatar from '@/assets/colin.jpg'
import { person, projects, work } from '@/data/profile'
import { getColinArticles } from '@/lib/getAllArticles'
import { profilePage } from '@/lib/schema'

const articles = await getColinArticles()
const [headers, draftside, council] = projects
const portrait = await getImage({ src: avatar, width: 400, height: 400, format: 'jpg' })
const schema = profilePage(`${person.name} – ${person.title}`, new URL(portrait.src, Astro.site).href)
---

<Layout image="/og/home.png" schema={schema}>
  <!-- The entrance plays once per visit; coming back later, the page is just there. -->
  <script is:inline>
    try {
      if (sessionStorage.getItem('visited')) document.documentElement.classList.add('seen')
      sessionStorage.setItem('visited', '1')
    } catch {}
  </script>

  <div class="container">
    <header class="page-head intro">
      <div class="who rise">
        <Image
          src={avatar}
          alt="Colin Armstrong"
          widths={[72, 144, 216]}
          sizes="72px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          class="face"
        />
        <div>
          <h1>{person.name}</h1>
          <p class="role">{person.title} · {person.previously}</p>
        </div>
      </div>

      <div class="bio rise" style="--i:1">
        <p>
          I'm building <a class="link" href="https://paragraph.com" rel="noopener">Paragraph</a>, the media engine for
          early-stage startups. We help founders turn launches, product updates, and what they're learning into media
          they own. In 2024 we acquired Mirror and raised $5 million from USV and Coinbase Ventures.
        </p>
        <p>
          Before that, I led anti-abuse and privacy engineering teams at Google and helped build Coinbase's payments
          infrastructure. I also angel invest in early-stage startups like <a
            class="link"
            href="https://farcaster.xyz"
            rel="noopener">Farcaster</a
          >, <a class="link" href="https://daimo.com" rel="noopener">Daimo</a>, and <a
            class="link"
            href="https://layer3.xyz"
            rel="noopener">Layer3</a
          >, and back venture funds as a limited partner.
        </p>
        <p>
          On the side I build small tools like <a class="link" href={headers.href} rel="noopener">{headers.name}</a>, <a
            class="link"
            href={draftside.href}
            rel="noopener">{draftside.name}</a
          >, and <a class="link" href={council.href} rel="noopener">{council.name}</a>. In my free time I enjoy <a
            class="link"
            href="/photography">photography</a
          >, wine, cooking & cycling.
        </p>
        <p class="ask">
          If you're a founder building something early, <a class="link" href={`mailto:${person.email}`}>email me</a>.
        </p>
      </div>
    </header>

    <section class="section rise" style="--i:2" aria-labelledby="work">
      <div class="section-head">
        <h2 id="work">Work</h2>
        <a class="more" href="/projects">
          Projects & Work
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M3 8h9.5M8.5 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      <WorkTimeline roles={work} />
    </section>

    {
      articles.length > 0 && (
        <section class="section" aria-labelledby="writing">
          <div class="section-head">
            <h2 id="writing">Writing</h2>
            <a class="more" href="/writing">
              All posts
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M3 8h9.5M8.5 4l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
          <PostList posts={articles.slice(0, 5)} />
        </section>
      )
    }
  </div>
</Layout>

<style>
  .intro {
    padding-top: 64px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .face {
    display: block;
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--line),
      0 0 0 4px var(--surface),
      0 0 0 5px var(--line);
  }

  .role {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 15px;
  }

  .bio {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    margin-top: 28px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .ask {
    color: var(--ink);
  }

  @media (max-width: 639px) {
    .intro {
      padding-top: 36px;
    }

    .who {
      align-items: flex-start;
      gap: 14px;
    }

    .face {
      width: 56px;
      height: 56px;
    }

    .role {
      font-size: 14px;
    }

    .bio {
      margin-top: 22px;
      font-size: 15px;
    }
  }
</style>
